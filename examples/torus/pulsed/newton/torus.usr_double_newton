c-----------------------------------------------------------------------
      subroutine userchk
      use stdlib_logger, only: debug_level, information_level
      use stdlib_linalg, only: inv
      use LightKrylov_Constants
      use LightKrylov_Timing, only: timer => global_lightkrylov_timer
      use LightKrylov_Logger
      use neklab
      use neklab_helix
      use neklab_nek_setup
      implicit none     
      include "SIZE"
      include "TOTAL"
      
      ! System for which we seek a fixed point
      type(nek_system_torus), allocatable :: sys
      ! State vectors
      type(nek_dvector) :: bf, ref
      ! Tolerance for the Newton solver
      real(dp) :: tol
      real(dp) :: df
      ! flow parameters
      !real, parameter :: womersley   = 35.0d0
      ! corresponds to Q = 1%
      !real, parameter :: dp0ds       = 7.946035446259826e-02
      !real, parameter :: dp1dsr      = 6.088015703926612e-04
      !real, parameter :: dp1dsi      = 1.210241163576931e-02
		real, parameter :: womersley   = 100.0d0
      ! corresponds to Q = 20%
      real, parameter :: dp0ds       = 7.948934241227328e-02
      real, parameter :: dp1dsr      = 2.842725203120692e-02
      real, parameter :: dp1dsi      = 1.942304584125990e+00
		real(dp), dimension(3) :: dpds, dpds0, dpds_tmp
      real(dp), dimension(2), parameter :: mflow_target = [ 1.0_dp, 0.001_dp ]
      real(dp), dimension(2):: mf_old, mf_new, dmf, mf_err, deltaf
      real(dp), dimension(2,2) :: jac
      real(dp), dimension(nfft+1) :: mflow_old, mflow_new
      integer, parameter :: max_frc_iter = 5
      integer :: tol_mode, log_level, i
      integer :: frc_iter, icomp
      character(len=128) :: msg

      log_level = information_level
      
      inwt = 0
      if (istep.eq.0) then
         ! Set flow parameters
         dpds0 = [ dp0ds, dp1dsr, dp1dsi ]
	      call pipe%init_flow(dpds0, womersley)
			
         call load_fld('rsttorus0.f00001')
         call nek2vec(bf, vx, vy, vz, pr, t)
			
	      ! parameters
         tol = 1e-8_dp
         tol_mode = 2
         
         ! define system
         sys = nek_system_torus()
         sys%jacobian = nek_jacobian_torus()
         sys%jacobian%X = bf

         ! Set up logging & timing
         call logger_setup(nio=0, log_level=log_level, log_stdout=.false., log_timestamp=.true.)
         call timer%initialize(); call pipe%setup_summary(); call pipe%parameter_summary()
         ! Run Newton
         call newton_forced_periodic_orbit_torus(sys, bf, tol, tol_mode)
         call outpost(bf%vx, bf%vy, bf%vz, bf%pr, bf%theta, "BF_")
         ! Finalize system timings
         call sys%finalize_timer(); call timer%finalize()
         call pipe%get_mflow_fft(mflow_new)
         write(msg,'(A,E15.8)') 'base newton: mf_new= ', mflow_new(:2)
         call nek_log_message(msg, procedure='userchk')
         call rename('lightkrylov.log','lightkrylov_base_nwt.log')
         
         ! extract mflow FFT
         df = 100*tol
         ! set reference
         dpds = dpds0
         call nek2vec(ref, vx, vy, vz, pr, t)
         ! df newton
         df_loop: do frc_iter = 1, max_frc_iter
            call pipe%get_mflow_fft(mflow_old)
            mf_err = mflow_old(:2) - mflow_target
            write(msg,'(A,2(1X,F12.8),A,2(1X,E15.8))') 'mflow newton: mf=',
     $                mflow_old(:2), ', mf_error=', mf_err
            call nek_log_message(msg, procedure='userchk')
            if (sum(abs(mf_err)) < tol) exit df_loop ! converged
            do icomp = 1, size(mflow_target) ! we need to compute df/dmf for all components
               !
               ! get df/dmf for component icomp
               !
               ! Set flow parameters
               dpds_tmp = dpds
               dpds_tmp(icomp) = dpds(icomp) + df
			      call pipe%init_flow(dpds_tmp, womersley)
               call pipe%compute_bf_forcing(0.0_dp)
               ! Run Newton
               call newton_forced_periodic_orbit_torus(sys, bf, tol, tol_mode)
               call pipe%get_mflow_fft(mflow_new)
               
               ! get difference and compute gradient
               dmf = mflow_new(:2) - mflow_old(:2)
               do i = 1, 2
                  if (dmf(i) == 0.0_dp) then
                     write(msg,'(A,2(I0,A),E15.8)') 'mflow newton ', icomp,
     $                        ',', i, ': mf_df= ', ubar_new
                     call logger%log_message(msg, procedure='userchk')
                     write(msg,'(A,2(I0,A),E15.8)') 'mflow newton ', icomp, 
     $                        ',', i, ': dmf= ', dmf
                     call logger%log_message(msg, procedure='userchk')
                     call nek_stop_error('dmf = 0!', procedure='userchk')
                  end if   
                  jac(icomp,i) = df/dmf(i)
               end do
               write(msg,'(A,2(I0,A),2(1X,F12.8),A,2(1X,F12.8),A,2(1X,F12.8))') 
     $            'mflow newton ', icomp, ',', i, ': mf_new=', 
     $            mflow_new(:2), 'dmf= ', dmf, ', df/dmf= ',jac(icomp,:)
               call nek_log_message(msg, procedure='userchk')
            end do ! icomp
            call nek_log_message('mflow newton: mf jacobian')
            do icomp = 1, size(mflow_target)
               write(msg,'(4X,2(1X,F12.8))') jac(icomp,:)
               call nek_log_message(msg, procedure='userchk')
            end do
            !
            ! update
            !
            dmf = mflow_target - mflow_old(:2)
            deltaf = - matmul(inv(jac), dmf)
            write(msg,'(A,*(1x,E15.8))') 'deltaf= ', deltaf
            call nek_log_message(msg, procedure='userchk')
            call vec2nek(vx, vy, vz, pr, t, ref) ! reset reference solution
            ! Set flow parameters
            dpds(:2) = dpds(:2) + deltaf ! update reference forcing
			   call pipe%init_flow(dpds, womersley)
            call pipe%compute_bf_forcing(0.0_dp)
            ! Run Newton
            call newton_forced_periodic_orbit_torus(sys, bf, tol, tol_mode)
            call nek2vec(ref, vx, vy, vz, pr, t)
         end do df_loop
         call pipe%get_mflow_fft(mflow_old)
         mf_err = mflow_old(:2) - mflow_target
         if (sum(abs(mf_err)) > tol) then
            write(msg,'(A,I0,A)') 'Mass flux not converged after ', 
     $                           max_frc_iter, 'steps.'
            call nek_stop_error(msg, procedure='userchk')
         end if
         call outpost(bf%vx, bf%vy, bf%vz, bf%pr, bf%theta, "BF_")
         ! Finalize system timings
         call sys%finalize_timer(); call timer%finalize()
         call rename('lightkrylov.log','lightkrylov_mflow_nwt.log')
         call nek_end()
      end if

      return

      end
