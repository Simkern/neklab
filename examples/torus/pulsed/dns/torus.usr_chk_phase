c-----------------------------------------------------------------------
      subroutine userchk
      use neklab
      use neklab_helix
      use LightKrylov_Logger
      implicit none     
      include "SIZE"
      include "TOTAL"
      
      ! System for which we seek a fixed point
      type(nek_system_torus), allocatable :: sys
      ! State vectors
      type(nek_dvector) :: bf, bf_out
      ! Tolerance for the Newton solver
      real(dp) :: tol, ubar, ubar_old, norm, pd
      ! flow parameters
      real, parameter :: womersley   = 35.0d0
      ! corresponds to Q = 1%
      real, parameter :: dp0ds       = 7.9486896e-2 !7.966035446259826e-02
      real, parameter :: dp1dsr      = 6.088015703926612e-04
      real, parameter :: dp1dsi      = 1.210241163576931e-02
      real(dp), dimension(3) :: dpds
      integer :: i, j, outpost_step
      character(len=128) :: msg

      if (istep == 0) then
         call load_fld('rsttorus0.f00001')
         call nek2vec(bf, vx, vy, vz, pr, t)
         
         ! fully real
         dpds = [ dp0ds, sqrt(dp1dsr**2 + dp1dsi**2), 0.0_dp ]
         call pipe%init_flow(dpds, womersley)
         pd = pipe%get_period()
         
         call setup_nonlinear_solver(recompute_dt=.true., cfl_limit = 0.5_dp)
         
         call vec2nek(vx, vy, vz, pr, t, bf)
         time = 0.0_dp
         do ip = 1, nperiod
            do istep = 1, nsteps
               call pipe%compute_bf_forcing(time) ! --> set neklab_forcing data
               call nek_advance()
               call pipe%compute_mflow_fft(period=pd)      ! integrate Fourier coefficients
            end do
            call pipe%print_mflow_fft(nout=2)
            ubar = pipe%compute_ubar(vx,vy,vz)
            if (nid == 0) print *, time, time/pd, 'mass flow UBAR:', ubar     
         end do
         
         ! fully imaginary
         dpds = [ dp0ds, 0.0_dp, sqrt(dp1dsr**2 + dp1dsi**2) ]
         call pipe%init_flow(dpds, womersley)
         pd = pipe%get_period()
         
         call setup_nonlinear_solver(recompute_dt=.true., cfl_limit = 0.5_dp)
         
         call vec2nek(vx, vy, vz, pr, t, bf)
         time = 0.0_dp
         do ip = 1, nperiod
            do istep = 1, nsteps
               call pipe%compute_bf_forcing(time) ! --> set neklab_forcing data
               call nek_advance()
               call pipe%compute_mflow_fft(period=pd)      ! integrate Fourier coefficients
            end do
            call pipe%print_mflow_fft(nout=2)
            ubar = pipe%compute_ubar(vx,vy,vz)
            if (nid == 0) print *, time, time/pd, 'mass flow UBAR:', ubar     
         end do
         call nek_end()
      end if
      
      return

      end
