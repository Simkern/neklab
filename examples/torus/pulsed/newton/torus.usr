c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      udiff =0.0d0
      utrans=0.0d0
      end
c-----------------------------------------------------------------------
      subroutine userf(ix,iy,iz,ieg)
      use neklab
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      ffx = 0.0d0
      ffy = 0.0d0
      ffz = 0.0d0
      
      if (jp == 0) call neklab_forcing(ffx,ffy,ffz,ix,iy,iz,ieg,jp)
      
      end
c-----------------------------------------------------------------------
      subroutine userq(ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      qvol = 0.0d0
      source = 0.0d0
      end
c-----------------------------------------------------------------------
      subroutine userchk
      use stdlib_logger, only: debug_level, information_level
      use LightKrylov_Constants
      use LightKrylov_Timing, only: timer => global_lightkrylov_timer
      use LightKrylov_Logger
      use neklab
      use neklab_helix
      use neklab_nek_setup
      implicit none     
      include "SIZE"
      include "TOTAL"
      
      ! System for which we seek a fixed point
      type(nek_system_torus), allocatable :: sys
      ! State vectors
      type(nek_dvector) :: bf, test
      ! Tolerance for the Newton solver
      real(dp) :: tol
      real(dp) :: dubdf0, dubdf1
      real(dp) :: ubar_old, ubar_new, du
      real(dp) :: deltaf, df
      ! flow parameters
      real, parameter :: womersley   = 35.0d0
      ! corresponds to Q = 1%
      real, parameter :: dp0ds       = 7.946035446259826e-02
      real, parameter :: dp1dsr      = 6.088015703926612e-04
      real, parameter :: dp1dsi      = 1.210241163576931e-02
		!real, parameter :: womersley   = 100.0d0
      ! corresponds to Q = 20%
      !real, parameter :: dp0ds       = 7.948934241227328e-02
      !real, parameter :: dp1dsr      = 2.842725203120692e-02
      !real, parameter :: dp1dsi      = 1.942304584125990e+00
		real(dp), dimension(3) :: dpds, dpds0
      integer :: tol_mode, inwt, log_level
      character(len=128) :: msg
      character(len=3) :: fid
      real(dp), parameter :: ubar_target = 1.0_dp

      log_level = information_level
      
      inwt = 0
      if (istep.eq.0) then
         ! Set flow parameters
         dpds0 = [ dp0ds, dp1dsr, dp1dsi ]
	      call pipe%init_flow(dpds0, womersley)
			
         call load_fld('rsttorus0.f00001')
         call bf%zero()
         call nek2vec(bf, vx, vy, vz, pr, t)
			
		   ! parameters
         tol = 1e-8_dp
         tol_mode = 2
         df = 100*tol
         
         ! define system
         sys = nek_system_torus()
         sys%jacobian = nek_jacobian_torus()
         sys%jacobian%X = bf
         ubar_old = pipe%compute_ubar(bf%vx, bf%vy, bf%vz)
         write(msg,'(A,E15.8)') 'u_bar_init= ', ubar_old
         call logger%log_message(msg, procedure='userchk')
         
         ! Set up logging & timing
         call logger_setup(nio=0, log_level=log_level, log_stdout=.false., log_timestamp=.true.)
         call timer%initialize(); call pipe%setup_summary()
         write(msg,'(A,*(E15.8,1X))') 'forcing= ', dpds0
         call nek_log_message(msg, procedure='userchk')
         ! Run Newton
         inwt = inwt + 1
         call newton_forced_periodic_orbit_torus(sys, bf, tol, tol_mode)
         call outpost(bf%vx, bf%vy, bf%vz, bf%pr, bf%theta, "BF_")
         ! Finalize system timings
         call sys%finalize_timer(); call timer%finalize()
         ubar_old = pipe%compute_ubar(bf%vx, bf%vy, bf%vz)
         write(msg,'(A,E15.8)') 'u_bar= ', ubar_old
         call nek_log_message(msg, procedure='userchk')
         write(fid,'(I3.3)') inwt
         call rename('lightkrylov.log','lightkrylov_nwt'//fid//'.log')

         if (abs(ubar_old - ubar_target) > tol) then
            !
            ! get d_ubar/df 0
            !
            ! Set flow parameters
            dpds = dpds0
            dpds(1) = dpds(1) + df
			   call pipe%init_flow(dpds, womersley)
            ! Set up logging & timing
            call logger_setup(nio=0, log_level=log_level, log_stdout=.false., log_timestamp=.true.)
            call timer%initialize(); call pipe%setup_summary()
            write(msg,'(A,*(E15.8,1X))') 'forcing= ', dpds
            call nek_log_message(msg, procedure='userchk')
            ! Run Newton
            inwt = inwt + 1
            call newton_forced_periodic_orbit_torus(sys, bf, tol, tol_mode)
            call outpost(bf%vx, bf%vy, bf%vz, bf%pr, bf%theta, "BF_")
            ! Finalize system timings
            call sys%finalize_timer(); call timer%finalize()
            ubar_new = pipe%compute_ubar(bf%vx, bf%vy, bf%vz)
            du = ubar_new - ubar_old
            dubdf0 = du/df
            write(msg,'(3(A,E15.8))') 'u_bar_new= ', ubar_new, ', du= ', 
     $                                 du, 'du/df= ', dubdf0
            call nek_log_message(msg, procedure='userchk')
            write(fid,'(I3.3)') inwt
            call rename('lightkrylov.log','lightkrylov_nwt'//fid//'.log')
            !
            ! update
            ! 
            deltaf = (ubar_target - ubar_old)*dubdf0
            ! Set flow parameters
            dpds0(1) = dpds0(1) + deltaf ! update current reference forcing
            write(msg,'(A,*(E15.8,1X))') 'deltaf_0= ', deltaf
            call nek_log_message(msg, procedure='userchk')
			   call pipe%init_flow(dpds0, womersley)
            ! Set up logging & timing
            call logger_setup(nio=0, log_level=log_level, log_stdout=.false., log_timestamp=.true.)
            call timer%initialize(); call pipe%setup_summary()
            write(msg,'(A,*(E15.8,1X))') 'forcing= ', dpds0
            call nek_log_message(msg, procedure='userchk')
            ! Run Newton
            inwt = inwt + 1
            call newton_forced_periodic_orbit_torus(sys, bf, tol, tol_mode)
            call outpost(bf%vx, bf%vy, bf%vz, bf%pr, bf%theta, "BF_")
            ! Finalize system timings
            call sys%finalize_timer(); call timer%finalize()
            ubar_old = pipe%compute_ubar(bf%vx, bf%vy, bf%vz)
            write(msg,'(A,E15.8)') 'u_bar= ', ubar_old
            call nek_log_message(msg, procedure='userchk')
            write(fid,'(I3.3)') inwt
            call rename('lightkrylov.log','lightkrylov_nwt'//fid//'.log')
         end if

         if (abs(ubar_old - ubar_target) > tol) then
            !
            ! get d_ubar/df 1
            !
            ! Set flow parameters
            dpds = dpds0
            dpds(2) = dpds(2) + df
			   call pipe%init_flow(dpds, womersley)
            ! Set up logging & timing
            call logger_setup(nio=0, log_level=log_level, log_stdout=.false., log_timestamp=.true.)
            call timer%initialize(); call pipe%setup_summary()
            write(msg,'(A,*(E15.8,1X))') 'forcing= ', dpds
            call nek_log_message(msg, procedure='userchk')
            ! Run Newton
            inwt = inwt + 1
            call newton_forced_periodic_orbit_torus(sys, bf, tol, tol_mode)
            call outpost(bf%vx, bf%vy, bf%vz, bf%pr, bf%theta, "BF_")
            ! Finalize system timings
            call sys%finalize_timer(); call timer%finalize()
            ubar_new = pipe%compute_ubar(bf%vx, bf%vy, bf%vz)
            du = ubar_new - ubar_old
            dubdf0 = du/df
            write(msg,'(3(A,E15.8))') 'u_bar_new= ', ubar_new, ', du= ', 
     $                                 du, 'du/df= ', dubdf1
            call nek_log_message(msg, procedure='userchk')
            write(fid,'(I3.3)') inwt
            call rename('lightkrylov.log','lightkrylov_nwt'//fid//'.log')
            !
            ! update
            ! 
            deltaf = (ubar_target - ubar_old)*dubdf0
            ! Set flow parameters
            dpds0(2) = dpds0(2) + deltaf ! update current reference forcing
			   call pipe%init_flow(dpds0, womersley)
            ! Set up logging & timing
            call logger_setup(nio=0, log_level=log_level, log_stdout=.false., log_timestamp=.true.)
            call timer%initialize(); call pipe%setup_summary()
            write(msg,'(A,*(E15.8,1X))') 'forcing= ', dpds0
            call nek_log_message(msg, procedure='userchk')
            ! Run Newton
            inwt = inwt + 1
            call newton_forced_periodic_orbit_torus(sys, bf, tol, tol_mode)
            call outpost(bf%vx, bf%vy, bf%vz, bf%pr, bf%theta, "BF_")
            ! Finalize system timings
            call sys%finalize_timer(); call timer%finalize()
            ubar_old = pipe%compute_ubar(bf%vx, bf%vy, bf%vz)
            write(msg,'(A,E15.8)') 'u_bar= ', ubar_old
            call nek_log_message(msg, procedure='userchk')
            write(fid,'(I3.3)') inwt
            call rename('lightkrylov.log','lightkrylov_nwt'//fid//'.log')
         end if
         call nek_end()
      end if

      return

      end
c----------------------------------------------------------------------------------
      subroutine userbc(i,j,k,iside,eg)
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer i,j,k,iside,eg
      if (JP.eq.0) then ! velocity
            ux = 1.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp=0.0d0
         else           ! perturbation
            ux = 0.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp=0.0d0
         endif
      end
c-----------------------------------------------------------------------
      subroutine useric(i,j,k,eg)
      implicit none 
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer i,j,k,eg
        if (JP.eq.0) then ! velocity
            ux = 1.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp=0.0d0
         else             ! perturbation
            ux = 0.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp=0.0d0
         endif
      end
c-----------------------------------------------------------------------
      subroutine usrdat
      implicit none
      include 'SIZE'
      include 'TOTAL'
      call setbc(1,1,'W  ')
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      use stdlib_logger, only: debug_level, information_level
      use LightKrylov_Logger
      use neklab_helix
      implicit none
      include 'SIZE'
      include 'TOTAL'
      ! geometry parameters
      real, parameter :: delta       = 0.3d0
      real, parameter :: diameter    = 2.0d0
      real, parameter :: pitch_s     = 0.0d0
      real, parameter :: length      = 1.0d0
      ! mesh parameters
      integer, parameter :: nslices  = 5
      integer, parameter :: nelf     = 108
      if (istep.eq.0) then
         ! Setup logger
         call logger_setup(nio=0, log_level=information_level, log_stdout=.false., log_timestamp=.true.)
         ! Initialize type, set geometry and compute forcing distribution
         call helix_pipe(delta, diameter, pitch_s, length, nslices, nelf)
      endif
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      end
c-----------------------------------------------------------------------
