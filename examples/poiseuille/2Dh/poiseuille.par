[GENERAL]
#stopat = numSteps
#numsteps = 1000 
stopat = endTime
endTime = 200.0
#
dt = 0.033577862
variableDT = no
targetCFL = 0.5
timestepper = bdf3
writecontrol = runTime
writeinterval = 5000  
#writecontrol = timeStep
#writeinterval = 50000 
#dealiasing = yes
#
[PROBLEMTYPE]
equation = incompLinNS
numberOfPerturbations = 2
solveBaseflow = no
variableProperties = no
#
[VELOCITY]
residualtol = 1e-8
residualproj = no
density = 1
viscosity = -5000.0
#
[PRESSURE]
preconditioner = semg_xxt
residualtol = 1e-8
residualproj = no
writetofieldfile = yes
#
[TEMPERATURE]
conductivity = 0.0002
rhocp = 1.0
writetofieldfile = yes
