[GENERAL]
#stopat = numSteps
#numsteps = 1000 
stopat = endTime
endTime = 5.0
#
dt = 0.033577862
variableDT = no
targetCFL = 0.5
timestepper = bdf3
writecontrol = runTime
writeinterval = 5000000  
#writecontrol = timeStep
#writeinterval = 50000 
#dealiasing = yes
#
[PROBLEMTYPE]
equation = incompLinNS
numberOfPerturbations = 1
solveBaseflow = no
variableProperties = no
#
[PRESSURE]
residualtol = 1e-8
residualproj = no
#
[VELOCITY]
residualtol = 1e-8
residualproj = yes
density = 1
viscosity = -5000.0
