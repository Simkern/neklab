c-----------------------------------------------------------------------
c     This routine to modify element vertices
      subroutine usrdat

      implicit none

      include 'SIZE'
      include 'TOTAL'

      real glmin,glmax
           
      real fact,x_min,x_max,y_max,y_min,z_min,z_max
      integer n

      n = 8*nelv
      
      fact = 4.*atan(1.)
      call cmult(xc,fact,n)
      if (if3d) then    
        call cmult(zc,fact,n)
      endif     

      x_min=glmin(xc,n)
      y_min=glmin(yc,n)
      x_max=glmax(xc,n)
      y_max=glmax(yc,n)
      if (if3d) then
        z_min=glmin(zc,n)
        z_max=glmax(zc,n)
      endif
      
      return
      end
