c-----------------------------------------------------------------------
      subroutine userchk
      use neklab
      use neklab_nek_setup
      use neklab_helix
      use LightKrylov_Logger
      implicit none     
      include "SIZE"
      include "TOTAL"
      
      ! State vectors
      type(nek_dvector) :: bf
      ! flow parameters
      real, parameter :: womersley   = 35.0d0
      ! corresponds to Q = 17%
      real, parameter :: dp0ds       = 8.1187279029228190e-02_dp  !7.966035446259826e-02
      real, parameter :: dp1dsr      = 2.0700294919047971e-02_dp  !6.088015703926612e-04
      real, parameter :: dp1dsi      = 4.1150274152849475e-01_dp  !1.210241163576931e-02
      real(dp), dimension(3) :: dpds
      character(len=128) :: msg

      if (istep == 0) then
         call load_fld('rsttorus0.f00001') ! start from steady state
         call nek2vec(bf, vx, vy, vz, pr, t)

         dpds = [ dp0ds, dp1dsr, dp1dsi ]
         call pipe%init_flow(dpds, womersley)

         write(msg,'(A,I0)') 'Prerun ', i
         call nek_log_message(msg, procedure='userchk')
         call setup_nonlinear_solver(variable_dt = .true., 
     $                               endtime     = pipe%get_period(), 
     $                               cfl_limit   = 0.4_dp)
         call vec2nek(vx, vy, vz, pr, t, bf)
         time = 0.0_dp
         istep = 0
         call pipe%reset_mflow_fft()
         do while (lastep == 0)
            istep = istep + 1
            call pipe%compute_bf_forcing(time) ! --> set neklab_forcing data
            call nek_advance()
            call pipe%compute_mflow_fft(var_dt = .true.) ! integrate Fourier coefficients
         end do
         call pipe%extract_mflow_fft()
            
         call shift_mflow_phase_torus(bf, 2)

         call vec2nek(vx, vy, vz, pr, t, bf)
         
         call setup_nonlinear_solver(variable_dt = .true., 
     $                               endtime     = pipe%get_period(), 
     $                               cfl_limit   = 0.4_dp)
         time = 0.0_dp
         istep = 0
         call pipe%reset_mflow_fft()
         do while (lastep == 0)
            istep = istep + 1
            call pipe%compute_bf_forcing(time) ! --> set neklab_forcing data
            call nek_advance()
            call pipe%compute_mflow_fft(var_dt = .true.) ! integrate Fourier coefficients
         end do
         call pipe%extract_mflow_fft()
      end if
      
      return

      end
