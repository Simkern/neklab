#
# nek parameter file
#
[GENERAL] 
stopAt = endTime
endTime = 1.0

dt = 0 
timeStepper = bdf3
variableDt = yes
targetCFL = 0.5

writeControl = runTime
writeInterval = 50.0
writeDoublePrecision = yes
dealiasing = yes

filtering = explicit
filterweight = 0.01
filtercutoffratio = 0.84

[PROBLEMTYPE]
equation = incompNS

[MESH]
writeToFieldFile = yes

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-08
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-10
residualProj = yes
density = 1.0
viscosity = -800.0
advection = yes
writeToFieldFile = yes
