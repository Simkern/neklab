c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,ieg)

      implicit none

      include 'SIZE'
      include 'NEKUSE'          ! UDIFF, UTRANS

      integer ix,iy,iz,ieg

      UDIFF =0.
      UTRANS=0.

      return
      end
c-----------------------------------------------------------------------
      subroutine userf  (ix,iy,iz,ieg)

      implicit none
      include 'SIZE'
      include 'SOLN'            ! jp
      include 'NEKUSE'          ! FFX, FFY, FFZ
      include 'PARALLEL'        ! GLLEL
      integer :: ix,iy,iz,ieg

      FFX = 0.0 
      FFY = 0.0
      FFZ = 0.0 
     
      return
      end
c-----------------------------------------------------------------------
      subroutine userq  (ix,iy,iz,ieg)

      implicit none

      include 'SIZE'
      include 'NEKUSE'          ! QVOL
      include 'PARALLEL'        ! GLLEL
      integer :: ix,iy,iz,ieg
      
      QVOL = 0.0

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,eg)

      implicit none

      include 'SIZE'
      include 'NEKUSE'          ! UX, UY, UZ, TEMP, X, Y
      include 'SOLN'            ! jp

      integer ix,iy,iz,iside,eg

      if (jp.eq.0) then
c     baseflow
        if (cbu.eq.'v  ') then
          UX = 0.0d0
          UY = 0.0d0
          UZ = 0.0d0
        endif
      else
c     perturbations
        UX = 0.0d0
        UY = 0.0d0
        UZ = 0.0d0
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)

      implicit none

      include 'SIZE'
      include 'INPUT'
      include 'NEKUSE'          ! UX, UY, UZ, TEMP, Z
      include 'SOLN'            ! JP
      include 'PARALLEL'        ! gllel

      integer ix,iy,iz,ieg
      integer ie, ijke

      real amp, pi, kx(lpert), ky(lpert) 

      real mth_rand
      real xl(LDIM)
      real fcoeff(3)

      ie = gllel(ieg)

      pi = 4.0*atan(1.0)

c     velocity
c     base flow
      if (jp.eq.0) then
        UX = (1.0d0 - Y**2)
        UY = 0.0d0
        UZ = 0.0d0
      else
c     perturbation
        ijke = ix + lx1*((iy-1) + ly1*((iz-1) + lz1*(ie-1)))
        UX   = 0.d00
        UY   = 0.d00
        UZ   = 0.d00
        temp = 0.d00
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk

      use neklab
      implicit none
      include "SIZE"
      include "FDMH1"
      include "TOTAL"

      ! internal
      integer :: igeom, ie1, ie2, ie, ntot1, ntot2, intype, ilag
      real :: d2dz, ddz, dtbd
      character(len=3) :: prefix

      common /cgeom/ igeom

      real, dimension(lx1,ly1,lz1,lelv) :: tmpfact, tmp1, tmp2, tmp3
      real, dimension(lx1*ly1*lz1) :: wrk1, wrk2
      real w1, w2, w3, resv1, resv2, resv3, dv1, dv2, dv3, h1, h2, prextr
      real h2inv
      real(dp), dimension(LX2*LY2*LZ2*LELV) :: dpr, tmppr
      COMMON /SCRNS/  w1    (lx1,ly1,lz1,lelv)
     $ ,              w2    (lx1,ly1,lz1,lelv)
     $ ,              w3    (lx1,ly1,lz1,lelv)
     $ ,              RESV1 (LX1,LY1,LZ1,LELV)
     $ ,              RESV2 (LX1,LY1,LZ1,LELV)
     $ ,              RESV3 (LX1,LY1,LZ1,LELV)
     $ ,              DV1   (LX1,LY1,LZ1,LELV)
     $ ,              DV2   (LX1,LY1,LZ1,LELV)
     $ ,              DV3   (lx1,ly1,lz1,lelv)
      common /scrvh/  h1    (lx1,ly1,lz1,lelv)
     $ ,              h2    (lx1,ly1,lz1,lelv)
      common /scrhi/  h2inv (lx1,ly1,lz1,lelv)
      COMMON /SCRCH/  PREXTR(LX2,LY2,LZ2,LELV)

      logical, parameter :: debug = .false.
      integer, parameter :: nstp = 10

      ! State vectors
      type(nek_dvector) :: bf, ini
      real :: energy
      integer :: iter_gmres

      ntot1 = lx1*ly1*lz1*nelv
      ntot2 = lx2*ly2*lz2*nelv

      if (istep.eq.0) then
         call nek2vec(bf, vx, vy, vz, pr, t)
         
         call load_fld('IC_poiseuille.fld')
         call nek2vec(ini, vx, vy, vz, pr, t)

         call vec2nek(vxp, vyp, vzp, prp, tp, ini)
         call vec2nek(vx, vy, vz, pr, t, bf)   
         
         !call outpost(vxp, vyp, vzp, prp, tp, 'ini')
         if (debug) call outpost(vxp, vyp, vzp, prp, tp, 'vvv')
         
         do istep = 1, nstp
            call nekgsync
            call setup_convect(2) ! Save conv vel
            if (iftran) call settime
            call setsolv
            call comment
            
            call setprop
            do igeom = 1,ngeom
               do jp = 1, npert
                  if (nid==0.and.igeom==2) write(6,*) istep,time,'pert solve',jp

                  ifield = 1
                  if (igeom == 1) then
                  !
                  !  Old geometry, old velocity
                  !
                     call makefp               ! call userf and sets the forcing
                     call lagfieldp
                  !
                  else
                  !
                  !  New geometry, new velocity
                  !
                     intype = -1
                     imesh = 1
                     call sethlm   (h1,h2,intype)
                     !call cresvipp (resv1,resv2,resv3,h1,h2)
                     call bcdirvc (vxp(1,jp),vyp(1,jp),vzp(1,jp),v1mask,v2mask,v3mask)
                     call extrapprp(prextr)
                     call opgradt(resv1,resv2,resv3,prextr)
                     ! Diagnostics
                     !call opcopy(tmp1, tmp2, tmp3, vx, vy, vz)
                     !call opcopy(vx, vy, vz, resv1,resv2,resv3)
                     !call col2(vx, binvm1, ntot1)
                     !call col2(vy, binvm1, ntot1)
                     !call col2(vz, binvm1, ntot1)
                     !call opdssum(vx, vy, vz)
                     !call outpost(vx, vy, vz, prextr, t, 'tst')
                     !call opcopy(vx, vy, vz, tmp1, tmp2, tmp3)
                     ! Diagnostics
                     
                     call opadd2 (resv1,resv2,resv3,bfxp(1,jp),bfyp(1,jp),bfzp(1,jp))
                     !call ophx  (w1,w2,w3,vxp(1,jp),vyp(1,jp),vzp(1,jp),h1,h2)
                     CALL AXHELM (w1,vxp(1,jp),H1,H2,imesh,1)
                     CALL AXHELM (w2,vyp(1,jp),H1,H2,imesh,1)
                     CALL AXHELM (w3,vzp(1,jp),H1,H2,imesh,1)
                     call opsub2 (resv1,resv2,resv3,w1,w2,w3)
                     !call ophinv   (dv1,dv2,dv3,resv1,resv2,resv3,h1,h2,tolhv,nmxv)

                     ! Diagnostics
                     !call opcopy(tmp1, tmp2, tmp3, vx, vy, vz)
                     !call opcopy(vx, vy, vz, resv1,resv2,resv3)
                     !call col2(vx, binvm1, ntot1)
                     !call col2(vy, binvm1, ntot1)
                     !call col2(vz, binvm1, ntot1)
                     !call opdssum(vx, vy, vz)
                     !call hpts()
                     !call opcopy(vx, vy, vz, tmp1, tmp2, tmp3)
                     !print *, 'HPTS_FILE: resv'
                     ! Diagnostics

                     kfldfdm = -1
                     tolhv = abs(tolhv)

                     call dssum  (resv1,lx1,ly1,lz1)
                     call col2   (resv1,v1mask,ntot1)
                     if (param(22).eq.0.or.istep.le.10) call chktcg1 (tolhv,resv1,h1,h2,v1mask,vmult,imesh,1)
                     call cggo(dv1,resv1,h1,h2,v1mask,vmult,imesh,tolhv,nmxv,1,binvm1,'VELX')

                     call dssum  (resv2,lx1,ly1,lz1)
                     call col2   (resv2,v2mask,ntot1)
                     if (param(22).eq.0.or.istep.le.10) call chktcg1 (tolhv,resv2,h1,h2,v2mask,vmult,imesh,1)
                     call cggo(dv2,resv2,h1,h2,v2mask,vmult,imesh,tolhv,nmxv,1,binvm1,'VELY')

                     call dssum  (resv3,lx1,ly1,lz1)
                     call col2   (resv3,v3mask,ntot1)
                     if (param(22).eq.0.or.istep.le.10) call chktcg1 (tolhv,resv3,h1,h2,v3mask,vmult,imesh,1)
                     call cggo(dv3,resv3,h1,h2,v3mask,vmult,imesh,tolhv,nmxv,1,binvm1,'VELZ')

                     !call outpost(dv1, dv2, dv3, pr, t, 'dv_')

                     ! Diagnostics
                     !call opcopy(tmp1, tmp2, tmp3, vx, vy, vz)
                     !call opcopy(vx, vy, vz, dv1,dv2,dv3)
                     !call hpts()
                     !call opcopy(vx, vy, vz, tmp1, tmp2, tmp3)
                     !print *, 'HPTS_FILE: dv'
                     ! Diagnostics

                     call opadd2   (vxp(1,jp),vyp(1,jp),vzp(1,jp),dv1,dv2,dv3)

                     ! incomprp
                     
                     intype = 1
                     dtbd   = bd(1)/dt
                  
                     call rzero   (h1,ntot1)
                     call cmult2  (h2,vtrans(1,1,1,1,ifield),dtbd,ntot1)
                     call invers2 (h2inv,h2,ntot1)
                  
                     call opdiv   (dpr,vxp,vyp,vzp)
                     call chsign  (dpr,ntot2)

                     call ortho   (dpr)

                     ! Diagnostics
                     !call copy(tmppr, pr, ntot2)
                     !call copy(pr, dpr, ntot2)
                     !call col2(pr, bm2inv, ntot2)
                     !call hpts()
                     !call copy(pr, tmppr, ntot2)
                     !print *, 'HPTS_FILE: resp'
                     ! Diagnostics
                  
                     !call esolver (dpr,h1,h2,h2inv,intype)
                     call uzawa_gmres(dpr,h1,h2,h2inv,intype,iter_gmres)

                     ! Diagnostics
                     !call copy(tmppr, pr, ntot2)
                     !call copy(pr, dpr, ntot2)
                     !call hpts()
                     !call copy(pr, tmppr, ntot2)
                     !print *, 'HPTS_FILE: dp'
                  
                     call opgradt (w1 ,w2 ,w3 ,dpr)
                     call opbinv  (dv1,dv2,dv3,w1 ,w2 ,w3 ,h2inv)
                     call opadd2  (vxp,vyp,vzp, dv1,dv2,dv3)

                     ! Diagnostics
                     !call opcopy(tmp1, tmp2, tmp3, vx, vy, vz)
                     !call opcopy(vx, vy, vz, dv1,dv2,dv3)
                     !call hpts()
                     !call opcopy(vx, vy, vz, tmp1, tmp2, tmp3)
                     !print *, 'HPTS_FILE: dvdp'
                     ! Diagnostics

                     call extrapprp(prextr)
                     call lagpresp
                     call add3(prp, prextr, dpr, ntot2)

                     ! Diagnostics
                     call opcopy(tmp1, tmp2, tmp3, vx, vy, vz)
                     call opcopy(vx,vy,vz,vxp(1,jp),vyp(1,jp),vzp(1,jp))
                     call hpts()
                     call opcopy(vx, vy, vz, tmp1, tmp2, tmp3)
                     print *, 'HPTS_FILE: v'
                     call copy(tmppr, pr, ntot2)
                     call copy(pr, prp(1,jp), ntot2)
                     call hpts()
                     call copy(pr, tmppr, ntot2)
                     print *, 'HPTS_FILE: p'
                     ! Diagnostics
                  endif

               end do ! jp = 1, npert
            end do ! igeom = 1, ngeom
            if (debug) call outpost(vxp, vyp, vzp, prp, tp, 'vvv')

            if (mod(istep,100) == 0) call outpost(vxp, vyp, vzp, prp,tp,'prt')
         enddo
	      call nek_end()
      end if
      return
      end

c-----------------------------------------------------------------------
c     This routine to modify element vertices
      subroutine usrdat

      implicit none

      include 'SIZE'
      include 'TOTAL'

      real glmin,glmax
           
      real fact,x_min,x_max,y_max,y_min,z_min,z_max
      integer n

      n = 8*nelv
      
      fact = 4.*atan(1.)
      call cmult(xc,fact,n)
      if (if3d) then    
        call cmult(zc,fact,n)
      endif     

      x_min=glmin(xc,n)
      y_min=glmin(yc,n)
      x_max=glmax(xc,n)
      y_max=glmax(yc,n)
      if (if3d) then
        z_min=glmin(zc,n)
        z_max=glmax(zc,n)
      endif
      
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      implicit none
      
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      implicit none

      return
      end
