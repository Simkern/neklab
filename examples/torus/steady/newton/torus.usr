c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      udiff =0.0d0
      utrans=0.0d0
      end
c-----------------------------------------------------------------------
      subroutine userf(ix,iy,iz,ieg)
      use neklab
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      ffx = 0.0d0
      ffy = 0.0d0
      ffz = 0.0d0
      
      if (jp == 0) call neklab_forcing(ffx,ffy,ffz,ix,iy,iz,ieg,jp)
      
      end
c-----------------------------------------------------------------------
      subroutine userq(ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      qvol = 0.0d0
      source = 0.0d0
      end
c-----------------------------------------------------------------------
      subroutine userchk
      use stdlib_logger, only: debug_level, information_level
      use LightKrylov_Constants
      use LightKrylov_Timing, only: timer => global_lightkrylov_timer
      use LightKrylov_Logger
      use neklab
      use neklab_helix
      use neklab_nek_setup
      implicit none     
      include "SIZE"
      include "TOTAL"
      
      ! System for which we seek a fixed point
      type(nek_system), allocatable :: sys
      ! State vectors
      type(nek_dvector) :: bf
      ! Tolerance for the Newton solver
      real(dp) :: tol, ubar_old, ubar_new, deltaf, df, dmf, dfdmf, mferr
      ! flow parameters
      real, parameter :: dpds0 = 7.9486896e-2
      real(dp), dimension(1) :: dpds, dpds_tmp
      real(dp), parameter :: mflow_target = 1.0_dp
      real(dp), dimension(nfft+1) :: mflow_old, mflow_new
      integer, parameter :: max_frc_iter = 5
      integer :: tol_mode, inwt, log_level, frc_iter
      character(len=128) :: msg
      character(len=3) :: fid
      
      log_level = information_level

      if (istep.eq.0) then
	   ! Set flow parameters
         dpds = [ dpds0 ]
	      call pipe%init_flow(dpds)
         call pipe%compute_bf_forcing(0.0_dp)
			
	      call load_fld('rsttorus0.f00001')
         call nek2vec(bf, vx, vy, vz, pr, t)
         
         ! parameters
         tol = 1e-8_dp
         tol_mode = 2
         df = 100*tol
         
         ! define system
         sys = nek_system()
         sys%jacobian = nek_jacobian()
         sys%jacobian%X = bf
         ubar_old = pipe%compute_ubar(bf%vx, bf%vy, bf%vz)
         write(msg,'(A,E15.8)') 'base newton: mf_init= ', ubar_old
         call logger%log_message(msg, procedure='userchk')
         
         ! Set up logging & timing
         call logger_setup(nio=0, log_level=log_level, log_stdout=.false., log_timestamp=.true.)
         call timer%initialize(); call pipe%setup_summary(); call pipe%parameter_summary()
         ! Run Newton
         call newton_fixed_point_iteration(sys, bf, tol, tol_mode)
         call outpost(bf%vx, bf%vy, bf%vz, bf%pr, bf%theta, "BF_")
         ! Finalize system timings
         call sys%finalize_timer(); call timer%finalize()
         ubar_old = pipe%compute_ubar(bf%vx, bf%vy, bf%vz)
         write(msg,'(A,E15.8)') 'base newton: mf_new= ', ubar_old
         call nek_log_message(msg, procedure='userchk')
         call rename('lightkrylov.log','lightkrylov_base_nwt.log')
         
         ! Set up logging & timing
         call logger_setup(nio=0, log_level=log_level, log_stdout=.false., log_timestamp=.true.)
         call timer%initialize(); call pipe%setup_summary(); call pipe%parameter_summary()
         dpds = dpds0
         df_loop: do frc_iter = 1, max_frc_iter
            ubar_old = pipe%compute_ubar(bf%vx, bf%vy, bf%vz)
            mferr = ubar_old - mflow_target
            write(msg,'(A,F12.8,A,E15.8)') 'mflow newton: mf_old= ', 
     $                  ubar_old, ', mf_error= ', mferr
            call nek_log_message(msg, procedure='userchk')
            if (abs(mferr) < tol) exit df_loop ! converged
            !
            ! get df/dmf for component 1
            !
            ! Set flow parameters
            dpds_tmp = dpds + df
	         call pipe%init_flow(dpds_tmp)
            call pipe%compute_bf_forcing(0.0_dp)
            ! Run Newton
            call newton_fixed_point_iteration(sys, bf, tol, tol_mode)
            ubar_new = pipe%compute_ubar(bf%vx, bf%vy, bf%vz)
            
            ! get difference and compute gradient
            dmf = ubar_new - ubar_old
            if (dmf == 0.0_dp) then
               write(msg,'(A,E15.8)') 'mflow newton: mf_df= ', ubar_new
               call logger%log_message(msg, procedure='userchk')
               write(msg,'(A,E15.8)') 'mflow newton: dmf= ', dmf
               call logger%log_message(msg, procedure='userchk')
               call stop_error('dmf = 0!', procedure='userchk')
            end if
            dfdmf = df/dmf
            write(msg,'(3(A,E15.8))') 'mflow newton: mf_new= ', ubar_new, 
     $                                ', dmf= ', dmf, ', df/dmf= ', dfdmf
            call nek_log_message(msg, procedure='userchk')
            !
            ! update
            ! 
            deltaf = (mflow_target - ubar_old)*dfdmf
            ! Set flow parameters
            dpds(1) = dpds(1) + deltaf ! update current reference forcing
            write(msg,'(A,*(E15.8,1X))') 'mflow newton: deltaf_0= ', deltaf
            call nek_log_message(msg, procedure='userchk')
	         call pipe%init_flow(dpds)
            call pipe%compute_bf_forcing(0.0_dp)
            ! Run Newton
            call newton_fixed_point_iteration(sys, bf, tol, tol_mode)
         end do df_loop
         if (abs(mferr) > tol) then
            write(msg,'(A,I0,A)') 'mflow newton: Mass flux not converged after ', 
            $                        max_frc_iter, 'steps.'
            call stop_error(msg, procedure='userchk')
         end if
         ! Finalize system timings
         call outpost(bf%vx, bf%vy, bf%vz, bf%pr, bf%theta, "BF_")
         call sys%finalize_timer(); call timer%finalize()
         call rename('lightkrylov.log','lightkrylov_mflow_nwt.log')
         call nek_end()
      end if

      return

      end
c----------------------------------------------------------------------------------
      subroutine userbc(i,j,k,iside,eg)
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer i,j,k,iside,eg
      if (JP.eq.0) then ! velocity
            ux = 1.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp=0.0d0
         else           ! perturbation
            ux = 0.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp=0.0d0
         endif
      end
c-----------------------------------------------------------------------
      subroutine useric(i,j,k,eg)
      implicit none 
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer i,j,k,eg
        if (JP.eq.0) then ! velocity
            ux = 1.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp=0.0d0
         else             ! perturbation
            ux = 0.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp=0.0d0
         endif
      end
c-----------------------------------------------------------------------
      subroutine usrdat
      implicit none
      include 'SIZE'
      include 'TOTAL'
      call setbc(1,1,'W  ')
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      use stdlib_logger, only: debug_level, information_level
      use LightKrylov_Logger
      use neklab_helix
      implicit none
      include 'SIZE'
      include 'TOTAL'
      ! geometry parameters
      real, parameter :: delta       = 0.3d0
      real, parameter :: diameter    = 2.0d0
      real, parameter :: pitch_s     = 0.0d0
      real, parameter :: length      = 1.0d0
      ! mesh parameters
      integer, parameter :: nslices  = 5
      integer, parameter :: nelf     = 108
      if (istep.eq.0) then
         ! Setup logger
         call logger_setup(nio=0, log_level=information_level, log_stdout=.false., log_timestamp=.true.)
         ! Initialize type, set geometry and compute forcing distribution
         call helix_pipe(delta, diameter, pitch_s, length, nslices, nelf)
      endif
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      end
c-----------------------------------------------------------------------
