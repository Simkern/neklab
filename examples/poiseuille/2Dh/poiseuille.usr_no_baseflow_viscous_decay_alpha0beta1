c-----------------------------------------------------------------------
      subroutine userchk

      use neklab
      use neklab_2Dh
      implicit none
      include "SIZE"
      include "FDMH1"
      include "TOTAL"

      ! State vectors
      type(nek_dvector), allocatable :: bf, prt_r, prt_i
      type(nek_zvector), allocatable :: prt, prt_out
      type(exptA_2Dh_linop), allocatable :: exptA

      ! parameters
      integer, parameter :: nxyz1 = lx1*ly1*lz1
      integer, parameter :: nxyz2 = lx2*ly2*lz2
      integer, parameter :: lv    = nxyz1*lelv
      
      ! internal
      integer :: ntot1, ntot2, i
      real(dp) :: betaz, Lz, tau, pih, nu
      real(dp) :: energy, theory, abs_error
      complex(dp), parameter :: one_cdp = (1.0_dp, 0.0_dp), im_cdp = (0.0_dp, 1.0_dp)

      character(len=*), parameter :: fmt = '(A4,I6,A)'

      integer, parameter :: nstp  = 100

      ntot1 = nxyz1*nelv
      ntot2 = nxyz2*nelv

      betaz = 1.0_dp
      nu    = param(2)
      Lz    = 2*pi
      imesh = 1
      pih   = 0.5*pi
      ! pert 1: real
      ! pert 2: imag

      allocate(bf, prt, prt_out)

      if (istep.eq.0) then

         call build_wmask(.true.)

         call prt%zero()
         do i = 1, ntot1
            prt%re%vx(i) = sin(pih*(ym1(i,1,1,1) + 1.0_dp))
         end do
         
         ! zero out pressure (sanity check)
         prt%re%pr = 0.0_dp; prt%im%pr = 0.0_dp
         prlagp = 0.0_dp

         !call outpost_nek(prt, 'ini')

         ! normalize
         call prt%scal(one_cdp/prt%norm())

         call vec2nek(vxp, vyp, vzp, prp, tp, prt)

         time = 0.0_dp
         energy = prt%norm()**2
         theory = exp(-2.0*nu*(pih**2 + betaz**2)*time)
         abs_error = abs(energy - theory)
         if (nid == 0) print *, 'time', time, 'energy', energy, theory, abs_error
	      do istep = 1, nstp
            call nek_advance_2Dh(betaz)
            call nek2vec(prt_out, vxp, vyp, vzp, prp, tp)
            energy = prt_out%norm()**2
            theory = exp(-2.0*nu*(pih**2 + betaz**2)*time)
            abs_error = abs(energy - theory)
            if (nid == 0) print *, 'time', time, 'energy', energy, theory, abs_error
         enddo

	      call nek_end()
      end if
      return
      end
