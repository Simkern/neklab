c-----------------------------------------------------------------------
      subroutine userchk
      use stdlib_logger, only: debug_level, information_level
      use LightKrylov_Constants
      use LightKrylov_Timing, only: timer => global_lightkrylov_timer
      use LightKrylov_Logger
      use neklab
      use neklab_helix
      use neklab_nek_setup
      implicit none     
      include "SIZE"
      include "TOTAL"
      
      ! System for which we seek a fixed point
      type(nek_system), allocatable :: sys
      ! State vectors
      type(nek_dvector) :: bf
      ! Tolerance for the Newton solver
      real(dp) :: tol, ubar, norm, pd
      ! flow parameters
      real, parameter :: dp0ds = 7.9486896e-2 !7.945994987500288e-02 ! 
      real(dp), dimension(1), parameter :: dpds = [ dp0ds ]
      integer :: outpost_step, ip, nperiod

      if (istep == 0) then
         call pipe%setup_summary()
         ! Set flow parameters
         call pipe%init_flow(dpds)
         call timer%initialize(); call pipe%setup_summary(); call pipe%parameter_summary()

	      call load_fld('rsttorus0.f00001')
	      call nek2vec(bf, vx, vy, vz, pr, t)
         
         time = 0.0_dp
         pipe%if_fft = .true.
         pd = 1.0_dp
         nperiod = 1
         ubar = pipe%compute_ubar(vx,vy,vz)
         if (nid == 0) print *, time, time/pd, 'mass flow UBAR:', ubar
         call setup_nonlinear_solver(recompute_dt=.true.,endTime=1.0_dp, 
     $      cfl_limit = 0.5_dp)

         do ip = 1, nperiod
            do istep = 1, nsteps
               call pipe%compute_bf_forcing(time) ! --> set neklab_forcing data
               call nek_advance()
               !call pipe%save_2d_fields(vx,vy,vz) ! save 2D flow fields
               call pipe%compute_mflow_fft(period=pd)      ! integrate Fourier coefficients
            end do
            !call pipe%outpost_2d()                   ! output even if buffer is not full
            call pipe%print_mflow_fft(period=pd, nout=1)
            ubar = pipe%compute_ubar(vx,vy,vz)
            if (nid == 0) print *, time, time/pd, 'mass flow UBAR:', ubar         
         end do
      end if

      return
      end
