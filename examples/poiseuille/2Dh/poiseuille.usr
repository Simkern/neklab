      return
      end
c-----------------------------------------------------------------------
      subroutine userq  (ix,iy,iz,ieg)

      implicit none

      include 'SIZE'
      include 'SOLN'            ! jp
      include 'NEKUSE'          ! QVOL
      include 'PARALLEL'        ! GLLEL
