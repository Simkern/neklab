c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,ieg)

      implicit none

      include 'SIZE'
      include 'NEKUSE'          ! UDIFF, UTRANS

      integer ix,iy,iz,ieg

      UDIFF =0.
      UTRANS=0.

      return
      end
c-----------------------------------------------------------------------
      subroutine userf  (ix,iy,iz,ieg)

      implicit none
      include 'SIZE'
      include 'SOLN'            ! jp
      include 'NEKUSE'          ! FFX, FFY, FFZ
      include 'PARALLEL'        ! GLLEL
      integer :: ix,iy,iz,ieg
      integer :: e, ijke

      !real, dimension(lx1*ly1*lz1*lelv,lpert) :: frc_x, frc_y
      !common / f2Dh_m / frc_x, frc_y

      e = gllel(ieg)
      ijke = ix + lx1*((iy - 1) + ly1*((iz - 1) + lz1*(e - 1)))
      FFX = 0.0
      FFY = 0.0
      FFZ = 0.0 
     
      return
      end
c-----------------------------------------------------------------------
      subroutine userq  (ix,iy,iz,ieg)

      implicit none

      include 'SIZE'
      include 'SOLN'            ! jp
      include 'NEKUSE'          ! QVOL
      include 'PARALLEL'        ! GLLEL
      integer :: ix,iy,iz,ieg
      integer :: e, ijke

      !real, dimension(lx1*ly1*lz1*lelv,lpert) :: frc_q
      !common / f2Dh_t / frc_q

      
      e = gllel(ieg)
      ijke = ix + lx1*((iy - 1) + ly1*((iz - 1) + lz1*(e - 1)))
      QVOL = 0.0 !frc_q(ijke,jp) 

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,eg)

      implicit none

      include 'SIZE'
      include 'NEKUSE'          ! UX, UY, UZ, TEMP, X, Y
      include 'SOLN'            ! jp

      integer ix,iy,iz,iside,eg

      if (jp.eq.0) then
c     baseflow
        if (cbu.eq.'v  ') then
          UX = 0.0d0
          UY = 0.0d0
          UZ = 0.0d0
	  temp = 0.0d0
        endif
      else
c     perturbations
        UX = 0.0d0
        UY = 0.0d0
        UZ = 0.0d0
	temp = 0.0d0
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)

      implicit none

      include 'SIZE'
      include 'INPUT'
      include 'NEKUSE'          ! UX, UY, UZ, TEMP, Z
      include 'SOLN'            ! JP
      include 'PARALLEL'        ! gllel

      integer ix,iy,iz,ieg
      integer ie, ijke

      real amp, pi, kx(lpert), ky(lpert) 

      real mth_rand
      real xl(LDIM)
      real fcoeff(3)

      ie = gllel(ieg)

      pi = 4.0*atan(1.0)

c     velocity
c     base flow
      if (jp.eq.0) then
        UX = (1.0d0 - Y**2)
        UY = 0.0d0
        UZ = 0.0d0
	temp = 0.0d0
      else
c     perturbation
        ijke = ix + lx1*((iy-1) + ly1*((iz-1) + lz1*(ie-1)))
        UX   = 0.d00
        UY   = 0.d00
        UZ   = 0.d00
        temp = 0.d00
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk

      use neklab
      implicit none
      include "SIZE"
      include "FDMH1"
      include "TOTAL"

      ! State vectors
      type(nek_dvector) :: bf, prt_r, prt_i

      ! parameters
      integer, parameter :: nxyz1 = lx1*ly1*lz1
      integer, parameter :: nxyz2 = lx2*ly2*lz2
      integer, parameter :: lv    = nxyz1*lelv
      real(dp), parameter :: beta_z = 1.0_dp

      ! internal
      integer :: igeom, ie1, ie2, ie, ntot1, ntot2, intype, ilag, iter
      real :: dtbd
      character(len=3) :: prefix

      common /cgeom/ igeom

      real, dimension(lx1,ly1,lz1,lelv) :: dtp, tmp1, tmp2, htmp1, htmp2
      real, dimension(lx1*ly1*lz1*lelv,npert) :: dwdp
      real, dimension(lx1*ly1*lz1*lelv,ldim) :: usave
      real, dimension(lx2*ly2*lz2*lelv)      :: psave
      real :: ta, tb
      real, dimension(lx1*ly1*lz1) :: wrk1, wrk2
      real w1, w2, w3, resv1, resv2, resv3, dv1, dv2, dv3, h1, h2
      real h2inv
      real(dp), dimension(LX2*LY2*LZ2*LELV,lpert) :: prextr
      real(dp), dimension(LX2,LY2,LZ2,LELV)       :: pe
      real(dp), dimension(LX2*LY2*LZ2*LELV,lpert) :: dpr
      real(dp), dimension(LX1,LY1,LZ1,LELV) :: bm1h2inv
      COMMON /SCRNS/  w1    (lx1,ly1,lz1,lelv)
     $ ,              w2    (lx1,ly1,lz1,lelv)
     $ ,              w3    (lx1,ly1,lz1,lelv)
     $ ,              RESV1 (LX1,LY1,LZ1,LELV)
     $ ,              RESV2 (LX1,LY1,LZ1,LELV)
     $ ,              RESV3 (LX1,LY1,LZ1,LELV)
     $ ,              DV1   (LX1,LY1,LZ1,LELV)
     $ ,              DV2   (LX1,LY1,LZ1,LELV)
     $ ,              DV3   (LX1,LY1,LZ1,LELV)
      COMMON /SCRNS/ TA(LX1,LY1,LZ1,LELT)
     $              ,TB(LX1,LY1,LZ1,LELT)
      COMMON /SCRVH/  H1    (LX1,LY1,LZ1,LELV)
      COMMON /SCRCH/  H2    (LX1,LY1,LZ1,LELV)
      common /scrhi/ h2inv (lx1,ly1,lz1,lelv)

      !real, dimension(lx1*ly1*lz1*lelv,lpert) :: frc_x, frc_y, frc_q
      real, dimension(lx1*ly1*lz1*lelv,lpert) :: gradz_p
      real, dimension(lx2,ly2,lz2,lelv,lpert) :: frc_div
      !common / f2Dh_m / frc_x, frc_y
      !common / f2Dh_t / frc_q

      logical, parameter :: debug = .true.
      integer, parameter :: nstp  = 10

      ntot1 = lx1*ly1*lz1*nelv
      ntot2 = lx2*ly2*lz2*nelv

      ! pert 1: real
      ! pert 2: imag

      if (istep.eq.0) then
         ! save baseflow
         call nek2vec(bf, vx, vy, vz, pr, t)
         ! load prt IC uvw
         ! real part
         call load_fld('IC_poiseuille_uv_r.fld')
         call nek2vec(prt_r, vx, vy, vz, pr, t)
         call load_fld('IC_poiseuille_uw_r.fld')
         call copy(prt_r%theta, vy, ntot1)
         ! imag part
         call load_fld('IC_poiseuille_uv_i.fld')
         call nek2vec(prt_i, vx, vy, vz, pr, t)
         call load_fld('IC_poiseuille_uw_i.fld')
         call copy(prt_i%theta, vy, ntot1)

         ! reset baseflow
         call vec2nek(vx, vy, vz, pr, t, bf)
         ! set perturbations
         call copy(vxp(1,1),   prt_r%vx,    ntot1)
         call copy(vyp(1,1),   prt_r%vy,    ntot1)
         call copy(tp (1,1,1), prt_r%theta, ntot1)
         call copy(vxp(1,2),   prt_i%vx,    ntot1)
         call copy(vyp(1,2),   prt_i%vy,    ntot1)
         call copy(tp (1,1,2), prt_i%theta, ntot1)

         ! diagnositcs
         !call outpost(vx, vy, vz, pr, t, 'bas')
         !call outpost(vxp(1,1), vyp(1,1), vzp, prp(1,1), tp(1,1,1), 'p_r')
         !call outpost(vxp(1,2), vyp(1,2), vzp, prp(1,2), tp(1,1,2), 'p_i')
         !call outpost(vxp(1,1), vyp(1,1), vzp, prp(1,1),tp(1,1,1),'v_1')
         !call outpost(vxp(1,2), vyp(1,2), vzp, prp(1,2),tp(1,1,2),'v_2')

         
	      do istep = 1, nstp
            call nekgsync                    ! drive1 - nek_advance
            call setup_convect(2)            ! drive1 - nek_advance
            if (iftran) call settime         ! drive1 - nek_advance
            call setsolv                     ! drive1 - nek_advance
            call comment                     ! drive1 - nek_advance
            call setprop                     ! drive1 - nek_advance


            

            ! subtract best estimate for d/dz (p) from temperature forcing
            
            
            
            
            if (debug .and. nid == 0) print *, 'CHK istep', istep, 'compute pressure gradient term for tp'
            !call rzero(gradz_p, npert*ntot1)
            ! d/dz (p) = beta_z p_i - i beta_z p_r
            ifield = 1
            ! imaginary component of tp is forced by p_r
            jp = 1                                       ! jp for extrapolation of the correct pressure term
            call rzero(resv3, ntot1)
            call extrapprp(prextr(1,jp))                 ! compute pressure 
            call mappr(resv3, prextr(1,jp), wrk1, wrk2)  ! map to vmesh
            call cmult(resv3, beta_z, ntot1)             ! Im(d/dz (p)) =  beta_z (p_r)
            call col2 (resv3, bm1, ntot1)                ! old : we do not collocate with bm1 as this is done in makefp
            call copy (gradz_p(1,2), resv3, ntot1)       ! add to forcing term for imaginary part (2)
            
            !call outpost(gradz_p(1,2), gradz_p(1,2), vzp, prextr(1,1), tp(1,1,2),'trv')
            
            ! tp_r is forced by p_i
            jp = 2                                       ! jp for extrapolation of the correct pressure term
            call rzero(resv3, ntot1)
            call extrapprp(prextr(1,jp))                 ! compute pressure
            call mappr(resv3, prextr(1,jp), wrk1, wrk2)  ! map to vmesh
            call cmult(resv3, -beta_z, ntot1)            ! Re(d/dz (p)) = -beta_z (p_i)
            call col2 (resv3, bm1, ntot1)                ! old : we do not collocate with bm1 as this is done in makefp
            call copy (gradz_p(1,1), resv3, ntot1)       ! add to forcing term for real part (1)

            !call outpost(gradz_p(1,1), gradz_p(1,1), vzp, prextr(1,2), tp(1,1,1),'trv')

            !call outpost(v1mask, v2mask, v3mask, pr, t, 'tst')
            !call outpost(v3mask, v2mask, v1mask, pr, t, 'tst')

            



            ! Solve advection-diffusion equation for temperature (with additional forcing)
            ! Compute intermediate velocity in x,y and solve for pressure correction using added divergence term
            
            if (debug .and. nid == 0) print *, 'CHK istep', istep, 'Solve advection-diffusion for t (both perturbations)'          
            if (debug .and. nid == 0) print *, 'CHK istep', istep, 'Solve momentum equations for x/y (both perturbations)'
            do jp = 1, npert
               !print *, 'CHK ipert', jp
               do igeom = 1,ngeom
                  !print *, 'CHK     igeom', igeom
                  if (igeom == 1) then
                  !
                  !  Old geometry, old velocity
                  !
                     ifield = 1     !  velocity
                     call makefp                                                    ! perturb.f - perturbv
                     call lagfieldp                                                 ! perturb.f - perturbv
                     ifield = 2     !  temperature (w)
                     call makeqp
                     call lagscalp
                     !
                  else
                  !
                  !  New geometry, new velocity
                  !
                     intype = -1
                     ifield = 1     !  velocity
                     call sethlm   (h1,h2,intype)                                   ! perturb.f - perturbv  h1 = 1/Re, h2 = bd(1)/dt: H = (h1*A + h2*B)
                     !call cresvipp (resv1,resv2,resv3,h1,h2)                        ! perturb.f - perturbv  BCs; f = gradt (p) + ff[xy]; f - H*u 
                     call bcdirvc (vxp(1,jp),vyp(1,jp),vzp(1,jp),v1mask,v2mask,v3mask)
                     !ifield = 2     !  temperature (w)
                     CALL BCDIRSC (tp(1,1,jp))
                     !ifield = 1
                     call extrapprp(prextr)
                     call opgradt(resv1,resv2,resv3,prextr)      ! d/dx pr, d/dy pr
                     call copy(resv3, gradz_p(1,jp), ntot1)      ! d/dz pr
                     
                     ! Diagnostics
                     !write(prefix,'(A2,I1)') 'bf', jp
                     !call outpost(bfxp(1,jp), bfyp(1,jp),bfzp(1,jp),prp(1,jp),tp(1,1,jp),prefix)
                     !write(prefix,'(A2,I1)') 'bq', jp
                     !call outpost(bqp(1,ifield-1,jp), adqp(1,ifield-1,jp),bfzp(1,jp),prp(1,jp),tp(1,1,jp),prefix)
                     ! Diagnostics

                     call opadd2(resv1,resv2,resv3,bfxp(1,jp), bfyp(1,jp),bfzp(1,jp))
                     call   add2(resv3, bqp(1,1,jp), ntot1)
                     !call ophx_2Dh(w1,w2,w3,vxp(1,jp),vyp(1,jp),vzp(1,jp),h1,h2)
                     CALL AXHELM_2Dh(w1, vxp(1,jp),H1,H2,beta_z)
                     CALL AXHELM_2Dh(w2, vyp(1,jp),H1,H2,beta_z)
                     CALL AXHELM_2Dh(w3,tp(1,1,jp),H1,H2,beta_z)
                     call opsub2(resv1,resv2,resv3,w1,w2,w3)
                     call   sub2(            resv3,      w3,ntot1)
                     
                     !CALL BCNEUSC (TA,-1)                           ! does not appear in our case
                     !CALL ADD2    (H2,TA,NTOT1)                     ! does not appear in our case
                     !call add2    (h2,adqp(1,ifield-1,jp),ntot1)    ! does not appear in our case
                     !CALL AXHELM  (TA,TP (1,ifield-1,jp),H1,H2,IMESH,1)
                     !CALL SUB3    (TB,BQP(1,ifield-1,jp),TA,NTOT1)
                     !CALL BCNEUSC (TA,1)                            ! does not appear in our case
                     !CALL ADD2    (TB,TA,NTOT1)                     ! does not appear in our case

                     ! Diagnostics
                     !call opcopy(usave(1,1),usave(1,2),usave(1,ldim),resv1,resv2,resv3)
                     !call copy(tmp1,     resv3, ntot1)
                     !call copy(tmp2,tp(1,1,jp), ntot1)
                     !call col2(resv1,      binvm1, ntot1)
                     !call col2(resv2,      binvm1, ntot1)
                     !call col2(resv3,      binvm1, ntot1)
                     !call opdssum(resv1, resv2, resv3)
                     !call   dssum(resv3, lx1, ly1, lz1)
                     !!write(prefix,'(A2,I1)') 'rv', jp
                     !write(prefix,'(A3)') 'rvv' !, jp
                     !call copy(tp(1,1,jp), resv3, ntot1)
                     !call outpost(resv1, resv2, resv3, prp, tp, prefix)
                     !call opcopy(resv1,resv2,resv3,usave(1,1), usave(1,2),usave(1,ldim))
                     !call copy(resv3,      tmp1, ntot1)
                     !call copy(tp(1,1,jp), tmp2, ntot1)
                     !write(prefix,'(A2,I1)') 'pe', jp
                     !call outpost(vxp(1,jp),vyp(1,jp),vzp(1,jp),prextr(1,jp),tp(1,1,jp),prefix)
                     ! Diagnostics

                     !call ophinv_2Dh(dv1,dv2,dv3,resv1,resv2,resv3,h1, h2,tolhv,nmxv,beta_z) ! perturb.f - perturbv  out = (h1*A+h2*B)^-1 * in  (impl)         (induct.f)
                     kfldfdm = -1
                     tolhv = abs(tolhv)
                     ifield = 1 !  velocity

                     call dssum  (resv1,lx1,ly1,lz1)
                     call col2   (resv1,v1mask,ntot1)
                     if (param(22).eq.0.or.istep.le.10) call chktcg1 (tolhv,resv1,h1,h2,v1mask,vmult,imesh,1)
                     call cggo_2Dh(dv1,resv1,h1,h2,v1mask,vmult,imesh,tolhv,nmxv,1,binvm1,'VELX',beta_z)

                     call dssum  (resv2,lx1,ly1,lz1)
                     call col2   (resv2,v2mask,ntot1)
                     if (param(22).eq.0.or.istep.le.10) call chktcg1 (tolhv,resv2,h1,h2,v2mask,vmult,imesh,2)
                     call cggo_2Dh(dv2,resv2,h1,h2,v2mask,vmult,imesh,tolhv,nmxv,1,binvm1,'VELY',beta_z)
                     call opadd2   (vxp(1,jp),vyp(1,jp),vzp(1,jp),dv1,dv2,dv3)      ! perturb.f - perturbv

                     !call dssum  (TB,lx1,ly1,lz1)
                     !call col2   (TB,v1mask,ntot1)
                     !if (param(22).eq.0.or.istep.le.10) call chktcg1 (tolhv,TB,h1,h2,v1mask,vmult,imesh,1)
                     !call cggo_2Dh(dv3,TB,h1,h2,v1mask,vmult,imesh, tolhv,nmxv,1,binvm1,'VELZ',beta_z)
                     call dssum  (resv3,lx1,ly1,lz1)
                     call col2   (resv3,v3mask,ntot1)
                     if (param(22).eq.0.or.istep.le.10) call chktcg1 (tolhv,resv3,h1,h2,v3mask,vmult,imesh,1)
                     call cggo_2Dh(dv3,resv3,h1,h2,v3mask,vmult,imesh, tolhv,nmxv,1,binvm1,'VELZ',beta_z)
                     !ifield = 2     !  temperature (w)
                     CALL ADD2    (TP(1,1,jp),dv3,NTOT1)
                     !CALL BCNEUSC (TA,1)
                     !CALL ADD2 (BQP(1,IFIELD-1,jp),TA,NTOT1)             ! does not appear in our case
                     
                     ! Diagnostics
                     !call copy(tmp1, tp(1,1,jp), ntot1)
                     !call copy(tp(1,1,jp), dv3, ntot1)
                     !!write(prefix,'(A2,I1)') 'dv', jp
                     !write(prefix,'(A3)') 'dvv' !, jp
                     !call outpost(dv1, dv2, dv3, prp, tp, prefix)
                     !call copy(tp(1,1,jp), tmp1, ntot1)
                  end if
               end do ! igeom
            end do ! jp
                  
            ! set frc_div as spanwise gradient of temperature
            if (debug .and. nid == 0) print *, 'CHK istep', istep, 'Compute inhomogeneity of the pressure equation'
            ! d/dz (tp) = beta_z tp_i - i beta_z tp_r
            jp = 1
            ! p_r is forced by tp_i
            do ie = 1, nelv
               ie1 = (ie-1)*nxyz1+1
               call map12 (frc_div(1,1,1,ie,jp), tp(ie1,1,2), ie)   ! map tp(2) to pmesh
            end do
            call cmult(frc_div(1,1,1,1,jp), beta_z, ntot2)            ! Re(frc_div) = beta_z tp_i
            call col2( frc_div(1,1,1,1,jp),  bm2, ntot2)            ! this is to be consistent with opdiv output
            if (debug .and. nid == 0) print *, 'CHK istep', istep, 2, 'frc_div(1)'
            jp = 2
            ! p_i is forced by tp_r
            do ie = 1, nelv
               ie1 = (ie-1)*nxyz1+1
               call map12 (frc_div(1,1,1,ie,jp), tp(ie1,1,1), ie)  ! map tp(1) to pmesh
            end do
            call cmult(frc_div(1,1,1,1,jp), -beta_z, ntot2)          ! Im(frc_div) = -beta_z tp_r
            call col2( frc_div(1,1,1,1,jp),   bm2, ntot2)          ! this is to be consistent with opdiv output
            if (debug .and. nid == 0) print *, 'CHK istep', istep, 1, 'frc_div(2)'
              
            if (debug .and. nid == 0) print *, 'CHK istep', istep, 'Compute pressure correction to enforce mass balance'
            do jp = 1, npert
               !   call incomprp (vxp(1,jp),vyp(1,jp),vzp(1,jp),prp(1,jp))       ! perturb.f - perturbv
               ! replaced by code below
            
               ifield = 1 ! velocity
               intype = 1                                                     ! perturb.f - incomprp
               dtbd   = bd(1)/dt                                              ! perturb.f - incomprp
               
               call rzero   (h1,ntot1)                                        ! perturb.f - incomprp
               call cmult2  (h2,vtrans(1,1,1,1,ifield),dtbd,ntot1)            ! perturb.f - incomprp  h2 = bd(1)/dt, vtrans = 1
               call invers2 (h2inv,h2,ntot1)                                  ! perturb.f - incomprp
                  
               call opdiv   (dpr(1,jp),vxp(1,jp),vyp(1,jp),vzp(1,jp))         ! perturb.f - incomprp  includes bm2 collocation                  (navier1.f)

               ! diagnostics
               !call copy(psave, dpr(1,jp), ntot2)
               !call col2(dpr(1,jp), bm2inv, ntot2)
               !write(prefix,'(A2,I1)') 'r1', jp
               !call outpost(vxp(1,jp),vyp(1,jp),vzp(1,jp),dpr(1,jp), tp(1,1,jp),prefix)
               !call copy(dpr(1,jp), psave, ntot2)
               ! diagnostics
                  
               !!! add frc_div to rhs
               call add2(dpr(1,jp),frc_div(1,1,1,1,jp),ntot2)                 ! rhs = div(u_r/i) -+ beta_z p_i/r
               !!!
                  
               call chsign  (dpr(1,jp),ntot2)                                 ! perturb.f - incomprp
               call ortho   (dpr(1,jp))                                       ! perturb.f - incomprp
             
               ! diagnostics
               !call copy(psave, dpr(1,jp), ntot2)
               !call col2(dpr(1,jp), bm2inv, ntot2)
               !write(prefix,'(A2,I1)') 'rp', jp
               !call outpost(vxp(1,jp),vyp(1,jp),vzp(1,jp),dpr(1,jp), tp(1,1,jp),prefix)
               !call copy(dpr(1,jp), psave, ntot2)
               ! diagnostics
             
               !call esolver (dpr(1,jp),h1,h2,h2inv,intype)                    ! perturb.f - incomprp
               call uzawa_gmres_2Dh(dpr(1,jp),h1,h2,h2inv,beta_z,intype,iter)
               
               ! diagnostics
               !write(prefix,'(A2,I1)') 'dp', jp
               !call outpost(vxp(1,jp),vyp(1,jp),vzp(1,jp),dpr(1,jp), tp(1,1,jp),prefix)
               ! diagnostics
            end do ! jp                




            ! Compute spanwise velocity correction from the pressure correction




            call rzero(dwdp, ntot1*npert)
            !! update spanwise velocity
            
            !!! compute spanwise pressure gradient add add it to tp
            if (debug .and. nid == 0) print *, 'CHK istep', istep, 'Add velocity correction for t'
            if (debug .and. nid == 0) print *, 'CHK istep', istep, 2, 'dt(1)'

            ! d/dz dpr = beta_z dpr_i - i beta_z dpr_r

            ! dtp(1) = beta_z dpr_i
            call mappr  (dwdp(1,1), dpr(1,2), wrk1, wrk2)              ! map dpr(2) to vmesh
            call cmult  (dwdp(1,1), -beta_z, ntot1)                    ! Re(dw) = -beta_z (dpr_i)
            ! dtp(2) = -beta_z dpr_r
            if (debug .and. nid == 0) print *, 'CHK istep', istep, 1, 'dt(2)'
            call mappr  (dwdp(1,2), dpr(1,1), wrk1, wrk2)              ! map dpr(1) to vmesh
            call cmult  (dwdp(1,2), beta_z, ntot1)                     ! Im(dw) =  beta_z (dpr_r)

            ! Diagnostic
            !if (debug) call outpost(dtp, dtp, dtp, dpr(1,1), tp, 'dtp')



            ! Reconstruct pressure and add pressure correction



            if (debug .and. nid == 0) print *, 'CHK istep', istep, 'Compute velocity correction based on pressure correction'
            ! prepare
            call invcol3 (bm1h2inv,bm1,h2inv,ntot1)    ! = bm1/h2inv = B*h2
            call dssum   (bm1h2inv,lx1,ly1,lz1)
            do jp = 1, npert
               call opgradt (w1 ,w2 ,w3 ,dpr(1,jp))                           ! perturb.f - incomprp  d/dx (dp), d/dy (dp)  (incl. bm2 coll)    (navier1.f)
               call opbinv  (dv1,dv2,dv3,w1 ,w2 ,w3 ,h2inv)                   ! perturb.f - incomprp  out = (h2*B)^-1 * in      (expl)          (navier1.f)
               ! dw
               call col2    (dwdp(1,jp), bm1,     ntot1)                      ! collocate bm1
               call col2    (dwdp(1,jp), v3mask,  ntot1)
               call dssum   (dwdp(1,jp), lx1, ly1, lz1)
               call invcol2 (dwdp(1,jp), bm1h2inv,ntot1)                    !  (h2*B)^-1 (-d/dz) (dpr_i) = dtp_r
               ! Diagnostics
               !call copy(tmp1,       tp(1,1,jp), ntot1)
               !call copy(tp(1,1,jp), dwdp(1,jp), ntot1)
               !write(prefix,'(A2,I1)') 'vv', jp
               !call outpost(dv1, dv2, dv3, prp, tp, prefix)
               !call copy(tp(1,1,jp), tmp1, ntot1)
               ! Diagnostics

               call opadd2  (vxp(1,jp),vyp(1,jp),vzp(1,jp), dv1,dv2,dv3)      ! perturb.f - incomprp
               call   add2  (tp(1,1,jp), dwdp(1,jp), ntot1)
            !end do
            !
            !call add2(tp(1,1,1), dwdp_r, ntot1)
            !call add2(tp(1,1,2), dwdp_i, ntot1)
            !
            !do jp = 1, npert
               ! Diagnostics
               write(prefix,'(A2,I1)') 'vl', jp
               call outpost(vxp(1,jp),vyp(1,jp),vzp(1,jp), prp(1,jp),tp(1,1,jp), prefix)
               ! Diagnostics
               
               call extrapprp(prextr(1,jp))                                   ! perturb.f - incomprp  Reconstruct pressure
               call lagpresp                                                  ! perturb.f - incomprp  Save lagged pressure
               call add3(prp(1,jp),prextr(1,jp),dpr(1,jp), ntot2)             ! perturb.f - incomprp  Add correction

               ! Diagnostics
               write(prefix,'(A2,I1)') 'pr', jp
               call outpost(vxp(1,jp),vyp(1,jp),vzp(1,jp), prp(1,jp),tp(1,1,jp), prefix)
               ! Diagnostics
            end do
         enddo
	      call nek_end()
      end if
      return
      end

c-----------------------------------------------------------------------
c     This routine to modify element vertices
      subroutine usrdat

      implicit none

      include 'SIZE'
      include 'TOTAL'

      real glmin,glmax
           
      real fact,x_min,x_max,y_max,y_min,z_min,z_max
      integer n

      n = 8*nelv
      
      fact = 4.*atan(1.)
      call cmult(xc,fact,n)
      if (if3d) then    
        call cmult(zc,fact,n)
      endif     

      x_min=glmin(xc,n)
      y_min=glmin(yc,n)
      x_max=glmax(xc,n)
      y_max=glmax(yc,n)
      if (if3d) then
        z_min=glmin(zc,n)
        z_max=glmax(zc,n)
      endif
      
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      implicit none
      
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      implicit none

      return
      end

      subroutine uzawa_gmres_2Dh(res,h1,h2,h2inv,beta_z,intype,iter)

c     Solve the pressure equation by right-preconditioned 
c     GMRES iteration.
c     intype =  0  (steady)
c     intype =  1  (explicit)
c     intype = -1  (implicit)

      include 'SIZE'
      include 'TOTAL'
      include 'GMRES'
      common  /ctolpr/ divex
      common  /cprint/ ifprint
      logical          ifprint
      real             res  (lx2*ly2*lz2*lelv)
      real             h1   (lx1,ly1,lz1,lelv)
      real             h2   (lx1,ly1,lz1,lelv)
      real             h2inv(lx1,ly1,lz1,lelv)
      !!! add the contribution from the 3rd perturbation component
      real             beta_z
      !!!

      common /scrmg/    wp (lx2,ly2,lz2,lelv)

      common /ctmp0/   wk1(lgmres),wk2(lgmres)
      common /cgmres1/ y(lgmres)

      real alpha, l, temp
      integer j,m
c
      logical iflag
      save    iflag
      data    iflag /.false./
      real    norm_fac
      save    norm_fac
c
      real*8 etime1,dnekclock
c
      if(.not.iflag) then
         iflag=.true.
         call uzawa_gmres_split0(ml_gmres,mu_gmres,bm2,bm2inv,
     $                           lx2*ly2*lz2*nelv)
         norm_fac = 1./sqrt(volvm2)
      endif
c
      etime1 = dnekclock()
      etime_p = 0.
      divex = 0.
      iter  = 0
      m = lgmres
c
      call chktcg2(tolps,res,iconv)
      if (param(21).gt.0.and.tolps.gt.abs(param(21))) 
     $   tolps = abs(param(21))
c     if (param(21).lt.0) tolps = abs(param(21))
      if (istep.eq.0) tolps = 1.e-4
      tolpss = tolps
c
      ntot2  = lx2*ly2*lz2*nelv
c
      iconv = 0
      call rzero(x_gmres,ntot2)

      do while(iconv.eq.0.and.iter.lt.100)

         if(iter.eq.0) then
                                                        !      -1
            call col3(r_gmres,ml_gmres,res,ntot2)       ! r = L  res

         else
            !update residual
            call copy(r_gmres,res,ntot2)                      ! r = res
            !call cdabdtp(w_gmres,x_gmres,h1,h2,h2inv,intype)  ! w = A x
            call cdabdtp_2Dh(w_gmres,x_gmres,h1,h2,h2inv,beta_z,intype) ! w = A x
            call add2s2(r_gmres,w_gmres,-1.,ntot2)            ! r = r - w
                                                              !      -1
            call col2(r_gmres,ml_gmres,ntot2)                 ! r = L   r
         endif
                                                            !            ______
         gamma_gmres(1) = sqrt(glsc2(r_gmres,r_gmres,ntot2))! gamma  = \/ (r,r) 
                                                            !      1
         if(iter.eq.0) then
            div0 = gamma_gmres(1)*norm_fac
            if (param(21).lt.0) tolpss=abs(param(21))*div0
         endif

         !check for lucky convergence
         rnorm = 0.
         if(gamma_gmres(1) .eq. 0.) goto 9000
         temp = 1./gamma_gmres(1)
         call cmult2(v_gmres(1,1),r_gmres,temp,ntot2)! v  = r / gamma
                                                     !  1            1
         do j=1,m
            iter = iter+1
                                                           !       -1
            call col3(w_gmres,mu_gmres,v_gmres(1,j),ntot2) ! w  = U   v
                                                           !           j
            
            etime2 = dnekclock()
            if(param(43).eq.1) then
               call uzprec(z_gmres(1,j),w_gmres,h1,h2,intype,wp)
            else                                        !       -1
               call hsmg_solve(z_gmres(1,j),w_gmres)    ! z  = M   w
            endif     
            etime_p = etime_p + dnekclock()-etime2
     
            call cdabdtp_2Dh(w_gmres,z_gmres(1,j),! w = A z
     $                   h1,h2,h2inv,beta_z,intype)      !        j
!            call cdabdtp(w_gmres,z_gmres(1,j),! w = A z
!     $                   h1,h2,h2inv,intype)      !        j
                                                  !      -1
            call col2(w_gmres,ml_gmres,ntot2)     ! w = L   w
                                               !          i,j  i

c           2-PASS GS, 1st pass:

            do i=1,j
               h_gmres(i,j)=vlsc2(w_gmres,v_gmres(1,i),ntot2) ! h    = (w,v )
            enddo                                             !  i,j       i

            call gop(h_gmres(1,j),wk1,'+  ',j)          ! sum over P procs

            do i=1,j
               call add2s2(w_gmres,v_gmres(1,i),-h_gmres(i,j),ntot2) ! w = w - h    v
            enddo                                                    !          i,j  i

            !apply Givens rotations to new column
            do i=1,j-1
               temp = h_gmres(i,j)                   
               h_gmres(i  ,j)=  c_gmres(i)*temp 
     $                        + s_gmres(i)*h_gmres(i+1,j)  
               h_gmres(i+1,j)= -s_gmres(i)*temp 
     $                        + c_gmres(i)*h_gmres(i+1,j)
            enddo
                                                              !            ______
            alpha = sqrt(glsc2(w_gmres,w_gmres,ntot2))        ! alpha =  \/ (w,w)
            rnorm = 0.
            if(alpha.eq.0.) goto 900  !converged
            l = sqrt(h_gmres(j,j)*h_gmres(j,j)+alpha*alpha)
            temp = 1./l
            c_gmres(j) = h_gmres(j,j) * temp
            s_gmres(j) = alpha  * temp
            h_gmres(j,j) = l
            gamma_gmres(j+1) = -s_gmres(j) * gamma_gmres(j)
            gamma_gmres(j)   =  c_gmres(j) * gamma_gmres(j)

c            call outmat(h,m,j,' h    ',j)
            
            rnorm = abs(gamma_gmres(j+1))*norm_fac
            ratio = rnorm/div0
            if (ifprint.and.nio.eq.0) 
     $         write (6,66) iter,tolpss,rnorm,div0,ratio,istep
   66       format(i5,1p4e12.5,i8,' Divergence')

#ifndef FIXITER
            if (rnorm .lt. tolpss) goto 900  !converged
#else
            if (iter.gt.param(151)-1) goto 900
#endif
            if (j.eq.m) goto 1000 !not converged, restart

            temp = 1./alpha
            call cmult2(v_gmres(1,j+1),w_gmres,temp,ntot2) ! v    = w / alpha
                                                           !  j+1            
         enddo
  900    iconv = 1
 1000    continue
         !back substitution
         !     -1
         !c = H   gamma
         do k=j,1,-1
            temp = gamma_gmres(k)
            do i=j,k+1,-1
               temp = temp - h_gmres(k,i)*c_gmres(i)
            enddo
            c_gmres(k) = temp/h_gmres(k,k)
         enddo
         !sum up Arnoldi vectors
         do i=1,j
            call add2s2(x_gmres,z_gmres(1,i),c_gmres(i),ntot2) 
                       ! x = x + c  z
                       !          i  i
         enddo
c        if(iconv.eq.1) call dbg_write(x,lx2,ly2,lz2,nelv,'esol',3)
      enddo
 9000 continue
c
      divex = rnorm
c
c     DIAGNOSTICS
       call ortho  (w_gmres) ! Orthogonalize wrt null space, if present
c     END DIAGNOSTICS
      call copy(res,x_gmres,ntot2)

      call ortho (res)  ! Orthogonalize wrt null space, if present

      etime1 = dnekclock()-etime1
      if (nio.eq.0) write(6,9999) istep,'  U-PRES gmres  ', 
     &                            iter,divex,div0,tolpss,etime_p,etime1
c     call flush_hack
 9999 format(i11,a,I6,1p5e13.4)

      return
      end

      subroutine cdabdtp_2Dh(ap,wp,h1,h2,h2inv,beta_z,intype)

C     INTYPE= 0  Compute the matrix-vector product    DA(-1)DT*p
C     INTYPE= 1  Compute the matrix-vector product    D(B/DT)(-1)DT*p
C     INTYPE=-1  Compute the matrix-vector product    D(A+B/DT)(-1)DT*p

      include 'SIZE'
      include 'TOTAL'
      REAL           AP    (LX2,LY2,LZ2,lelv)
      REAL           WP    (LX2,LY2,LZ2,lelv)
      REAL           H1    (LX1,LY1,LZ1,lelv)
      REAL           H2    (LX1,LY1,LZ1,lelv)
      REAL           H2INV (LX1,LY1,LZ1,lelv)
      !!! add the contribution from the 3rd perturbation component
      real           beta_z
C
      COMMON /SCRNS/ TA1 (LX1,LY1,LZ1,LELV)
     $ ,             TA2 (LX1,LY1,LZ1,LELV)
     $ ,             TA3 (LX1,LY1,LZ1,LELV)
     $ ,             TB1 (LX1,LY1,LZ1,LELV)
     $ ,             TB2 (LX1,LY1,LZ1,LELV)
     $ ,             TB3 (LX1,LY1,LZ1,LELV)
      real, dimension(lx1*ly1*lz1) :: wrk1, wrk2
      real, dimension(lx2,ly2,lz2,lelv) :: wdiv
      real, dimension(lx1,ly1,lz1,lelv) :: tmp1, tmp2

      integer :: ie, ntot1, ntot2

      ! Regular Ax = D (h2*B)^(-1) D^T
      call opgradt (ta1,ta2,ta3,wp)
      call opbinv  (TB1,TB2,TB3,TA1,TA2,TA3,H2INV)
      call opdiv   (ap,tb1,tb2,tb3)
      !!! add 3rd perturbation component. 
      ! we want to add the contribution
      !
      ! d/dz (h2*B)^(-1) d/dz wp = (-i beta_z) (h2*B)^(-1) (-i beta_z) wp = - beta_z^2 (h2*B)^(-1) wp
      !
      ! Note: we are only considering the ifanls = .false. case
      ntot1 = lx1*ly1*lz1*nelv
      ntot2 = lx2*ly2*lz2*nelv
      call invcol3 (tmp1,bm1,h2inv,ntot1)           ! = bm1/h2inv = h2*B
      call dssum   (tmp1,lx1,ly1,lz1)
      call mappr(tmp2, wp, wrk1, wrk2)              ! map wp to vmesh
      call col2( tmp2, bm1, ntot1)                  ! collocate bm1
      call col2( tmp2, v1mask, ntot1)
      call dssum(tmp2, lx1, ly1, lz1)
      call invcol2(tmp2, tmp1, ntot1)                ! collocate (h2*B)^-1
      call cmult(tmp2, -beta_z**2, ntot1)                 ! -beta_z^2 (h2*B)^(-1)
      do ie = 1, nelv
         call map12 (wdiv(1,1,1,ie), tmp2(1,1,1,ie), ie)  ! map ta3 to pmesh
      end do
      call col2(wdiv, bm2, ntot2)
      call sub2(ap, wdiv, ntot2)                     ! subtract because of chsign
      !!!
      return
      end

      subroutine axhelm_2Dh(Au,u,helm1,helm2,beta_z)
         include 'SIZE'
         include 'INPUT'
         include 'SOLN'
         REAL           AU    (LX1,LY1,LZ1,1)
         REAL           U     (LX1,LY1,LZ1,1)
         REAL           HELM1 (LX1,LY1,LZ1,1)
         REAL           HELM2 (LX1,LY1,LZ1,1)
         real beta_z
         ! internal
         real, dimension(lx1,ly1,lz1,lelv) :: tmp
         integer :: ntot1
         IMESH = 1
         ntot1 = lx1*ly1*lz1*nelv
         CALL AXHELM (Au,u,Helm1,Helm2,IMESH,1)
         call col3( tmp, u, vdiff(1,1,1,1,1),ntot1)
         call cmult(tmp,-beta_z**2, ntot1)
         call col2( tmp, bm1, ntot1)
         call add2(Au, tmp, ntot1)
      end

      subroutine cggo_2Dh(x,f,h1,h2,mask,mult,imsh,tin,maxit,isd,binv,name,beta_z)
C-------------------------------------------------------------------------
C
C     Solve the Helmholtz equation, H*U = RHS,
C     using preconditioned conjugate gradient iteration.
C     Preconditioner: diag(H).
C
C------------------------------------------------------------------------
      include 'SIZE'
      include 'TOTAL'
      include 'FDMH1'
 
      COMMON  /CPRINT/ IFPRINT, IFHZPC
      LOGICAL          IFPRINT, IFHZPC
 
      common /fastmd/ ifdfrm(lelt), iffast(lelt), ifh2, ifsolv
      logical ifdfrm, iffast, ifh2, ifsolv

      logical ifmcor,ifprint_hmh
 
      real x(1),f(1),h1(1),h2(1),mask(1),mult(1),binv(1)
      parameter        (lg=lx1*ly1*lz1*lelt)
      COMMON /SCRCG/ d (lg) , scalar(2)
      common /SCRMG/ r (lg) , w (lg) , p (lg) , z (lg)
c
      parameter (maxcg=900)
      common /tdarray/ diagt(maxcg),upper(maxcg)
      common /iterhm/ niterhm
      character*4 name
      real beta_z

c **  zero out stuff for Lanczos eigenvalue estimator
      call rzero(diagt,maxcg)
      call rzero(upper,maxcg)
      rho = 0.00
C
C     Initialization
C
      NXYZ   = lx1*ly1*lz1
      NEL    = NELV
      VOL    = VOLVM1
      IF (IMSH.EQ.2) NEL=NELT
      IF (IMSH.EQ.2) VOL=VOLTM1
      n      = NEL*NXYZ

      tol=abs(tin)

c     overrule input tolerance
      if (restol(ifield).ne.0) tol=restol(ifield)

      if (tin.lt.0) tol=abs(tin)
      niter = min(maxit,maxcg)

      if (.not.ifsolv) then
         call setfast(h1,h2,imsh)
         ifsolv = .true.
      endif
C
C     Set up diag preconditioner.
C
      if (kfldfdm.lt.0) then
         call setprec(D,h1,h2,imsh,isd)
      elseif(param(100).ne.2) then
         call set_fdm_prec_h1b(d,h1,h2,nel)
      endif

      call copy (r,f,n)
      call rzero(x,n)
      call rzero(p,n)

      fmax = glamax(f,n)
      if (fmax.eq.0.0) ifsolv=.false.
      if (fmax.eq.0.0) return

c     Check for non-trivial null-space

      ifmcor = .false.
      h2max = glmax(h2  ,n)
      skmin = glmin(mask,n)
      if (skmin.gt.0.and.h2max.eq.0) ifmcor = .true.
C
      if (name.eq.'PRES') then
c        call ortho (r)           ! Commented out March 15, 2011,pff
      elseif (ifmcor) then

         smean = -1./glsum(bm1,n) ! Modified 5/4/12 pff
         rmean = smean*glsc2(r,mult,n)
         call copy(x,bm1,n)
         call dssum(x,lx1,ly1,lz1)
         call add2s2(r,x,rmean,n)
         call rzero(x,n)
      endif
C
      krylov = 0
      rtz1=1.0
      niterhm = 0

      do iter=1,niter
C
         call col3(z,r,d,n) ! Joacobi
c
         rtz2=rtz1
         scalar(1)=vlsc3 (z,r,mult,n)
         if(param(18).eq.1) then
           scalar(2)=vlsc3(r,r,mult,n)
         else 
          scalar(2)=vlsc32(r,mult,binv,n)
         endif
         call gop(scalar,w,'+  ',2)
         rtz1=scalar(1)
         rbn2=sqrt(scalar(2)/vol)
         if (iter.eq.1) rbn0 = rbn2
         if (param(22).lt.0) tol=abs(param(22))*rbn0
         if (tin.lt.0)       tol=abs(tin)*rbn0

         ifprint_hmh = .false.
         if (nio.eq.0.and.ifprint.and.param(74).ne.0) ifprint_hmh=.true.
         if (nio.eq.0.and.istep.eq.1)                 ifprint_hmh=.true.

         if (ifprint_hmh) write(6,3002) istep,'  Hmholtz ' // name,  iter,rbn2,h1(1),tol,h2(1),ifmcor


c        Always take at least one iteration   (for projection) pff 11/23/98
#ifndef FIXITER
         IF (rbn2.LE.TOL.and.(iter.gt.1 .or. istep.le.5)) THEN
#else
         iter_max = param(150)
         if (name.eq.'PRES') iter_max = param(151)
         if (iter.gt.iter_max) then
#endif
c        IF (rbn2.LE.TOL) THEN
            NITER = ITER-1
c           IF(NID.EQ.0.AND.((.NOT.IFHZPC).OR.IFPRINT))
            if (nio.eq.0) write(6,3000) istep,'  Hmholtz ' // name, niter,rbn2,rbn0,tol
            goto 9999
         ENDIF
c
         beta = rtz1/rtz2
         if (iter.eq.1) beta=0.0
         call add2s1 (p,z,beta,n)
         call axhelm_2Dh (w,p,h1,h2,beta)
         call dssum  (w,lx1,ly1,lz1)
         call col2   (w,mask,n)
c
         rho0 = rho
         rho  = glsc3(w,p,mult,n)
         alpha=rtz1/rho
         alphm=-alpha
         call add2s2(x,p ,alpha,n)
         call add2s2(r,w ,alphm,n)
c
c        Generate tridiagonal matrix for Lanczos scheme
         if (iter.eq.1) then
            krylov = krylov+1
            diagt(iter) = rho/rtz1
         elseif (iter.le.maxcg) then
            krylov = krylov+1
            diagt(iter)    = (beta**2 * rho0 + rho ) / rtz1
            upper(iter-1)  = -beta * rho0 / sqrt(rtz2 * rtz1)
         endif
 1000 enddo
      niter = iter-1
c
      if (nio.eq.0) write (6,3001) istep, '  Error Hmholtz ' // name, niter,rbn2,rbn0,tol


 3000 format(i11,a,1x,I7,1p4E13.4)
 3001 format(i11,a,1x,I7,1p4E13.4)
 3002 format(i11,a,1x,I7,1p4E13.4,l4)
 9999 continue
      niterhm = niter
      ifsolv = .false.
c
c
c     Call eigenvalue routine for Lanczos scheme:
c          two work arrays are req'd if you want to save "diag & upper"
c
c     if (iter.ge.3) then
c        niter = iter-1
c        call calc (diagt,upper,w,z,krylov,dmax,dmin)
c        cond = dmax/dmin
c        if (nid.eq.0) write(6,6) istep,cond,dmin,dmax,' lambda'
c     endif
c   6 format(i9,1p3e12.4,4x,a7)
c
c     if (n.gt.0) write(6,*) 'quit in cggo'
c     if (n.gt.0) call exitt
c     call exitt
      return
      end

      subroutine ophinv_2Dh(o1,o2,o3,i1,i2,i3,h1,h2,tolh,nmxhi,beta_z)
C
C     Ok = (H1*A+H2*B)-1 * Ik  (implicit)
C
      include 'SIZE'
      include 'INPUT'
      include 'MASS'
      include 'SOLN'
      include 'VPROJ'
      include 'TSTEP'
c      logical ifproj
 
      real o1 (lx1,ly1,lz1,1) , o2 (lx1,ly1,lz1,1) , o3 (lx1,ly1,lz1,1)
      real i1 (lx1,ly1,lz1,1) , i2 (lx1,ly1,lz1,1) , i3 (lx1,ly1,lz1,1)
      real h1 (lx1,ly1,lz1,1) , h2 (lx1,ly1,lz1,1)
      real beta_z
 
c      ifproj = .false.
c      if (param(94).gt.0)    ifproj = .true.
c      if (ifprojfld(ifield)) ifproj = .true.
c 
c      if (.not.ifproj) then
c         if (ifield.eq.1) call ophinv
c     $      (o1,o2,o3,i1,i2,i3,h1,h2,tolh,nmxhi)
c         if (ifield.eq.ifldmhd) call ophinv
c     $      (o1,o2,o3,i1,i2,i3,h1,h2,tolh,nmxhi)
c         return
c      endif
 
      mtmp = param(93)
      do i=1,2*ldim
         ivproj(1,i) = min(mxprev,mtmp) - 1
      enddo
 
      imesh = 1
      ntot = lx1*ly1*lz1*nelv
 
      !call hsolve ('VELX',o1,i1,h1,h2,v1mask,vmult,imesh,tolh,nmxhi,1,vproj(1,1),ivproj(1,1),binvm1)
      !call hmholtz('VELX',o1,i1,h1,h2,v1mask,vmult,imesh,tolh,nmxhi,1)
      call dssum   (i1,lx1,ly1,lz1)
      call col2    (i1,v1mask,ntot)
c      if (nio.eq.0.and.istep.le.10) 
c     $    write(6,*) param(22),' p22 ',istep,imsh
      if (param(22).eq.0.or.istep.le.10)
     $    call chktcg1 (tol,i1,h1,h2,v1mask,vmult,imesh,1)
      call cggo_2Dh(o1,i1,h1,h2,v1mask,vmult,imesh,tolh,nmxhi,1,binvm1,'VELX',beta_z)
      !call hsolve ('VELY',o2,i2,h1,h2,v2mask,vmult,imesh,tolh,nmxhi,2,vproj(1,2),ivproj(1,2),binvm1)
      !call hmholtz('VELY',o2,i2,h1,h2,v2mask,vmult,imesh,tolh,nmxhi,2)
      if (param(22).eq.0.or.istep.le.10)
     $    call chktcg1 (tol,i2,h1,h2,v2mask,vmult,imesh,2)
      call cggo_2Dh(o2,i2,h1,h2,v2mask,vmult,imesh,tolh,nmxhi,2,binvm1,'VELY',beta_z)
C
      return
      end