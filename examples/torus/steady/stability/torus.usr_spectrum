c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      udiff =0.0d0
      utrans=0.0d0
      end
c-----------------------------------------------------------------------
      subroutine userf(ix,iy,iz,ieg)
      use neklab
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      ffx = 0.0d0
      ffy = 0.0d0
      ffz = 0.0d0
      
      if (jp == 0) call neklab_forcing(ffx,ffy,ffz,ix,iy,iz,ieg,jp)
      
      end
c-----------------------------------------------------------------------
      subroutine userq(ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      qvol = 0.0d0
      source = 0.0d0
      end
c-----------------------------------------------------------------------
      subroutine userchk
      use stdlib_logger, only: debug_level, information_level
      use stdlib_linalg, only: inv, det
      use LightKrylov_Constants
      use LightKrylov_Timing, only: timer => global_lightkrylov_timer
      use LightKrylov_Logger
      use neklab
      use neklab_helix
      implicit none 
      include "SIZE"
      include "TOTAL"
      
      ! System for which we seek a fixed point
      type(exptA_linop) :: LNS
      ! State vectors
      type(nek_dvector) :: bf
      ! flow parameters
      real, parameter :: dp0ds       = 7.9486896e-2
	real(dp), dimension(1) :: dpds
      integer, parameter :: kdim = 256, nev = 100
      real tau
      
      if (istep.eq.0) then
         ! Set flow parameters
         dpds = [ dp0ds ]
         call pipe%init_flow(dpds)
	   		
         ! Ensure the framework is in the right mode
         call pipe%set_newton(.false.)
         call pipe%set_floquet(.false.)
	   ! Load baseflow.
         call pipe%load_2d_fields(1)
         call pipe%set_baseflow(vx, vy, vz, 1)
         call nek2vec(bf, vx, vy, vz, pr, t)

	   call outpost(vx, vy, vz, pr, t, 'bf_')

         ! Exponential propagator.
         tau = 1.0_dp
         LNS = exptA_linop(tau, bf); call LNS%init()

         ! Stability analysis.
         call linear_stability_analysis_fixed_point(LNS, kdim, nev)

         call nek_end()
      end if

      return

      end
c----------------------------------------------------------------------------------
      subroutine userbc(i,j,k,iside,eg)
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer i,j,k,iside,eg
      if (JP.eq.0) then ! velocity
            ux = 1.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp=0.0d0
         else           ! perturbation
            ux = 0.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp=0.0d0
         endif
      end
c-----------------------------------------------------------------------
      subroutine useric(i,j,k,eg)
      implicit none 
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer i,j,k,eg
        if (JP.eq.0) then ! velocity
            ux = 1.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp=0.0d0
         else             ! perturbation
            ux = 0.0d0
            uy = 0.0d0
            uz = 0.0d0
            temp=0.0d0
         endif
      end
c-----------------------------------------------------------------------
      subroutine usrdat
      implicit none
      include 'SIZE'
      include 'TOTAL'
      call setbc(1,1,'W  ')
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      use stdlib_logger, only: debug_level, information_level
      use LightKrylov_Logger
      use neklab_helix
      implicit none
      include 'SIZE'
      include 'TOTAL'
      ! geometry parameters
      real, parameter :: delta       = 0.3d0
      real, parameter :: diameter    = 2.0d0
      real, parameter :: pitch_s     = 0.0d0
      !real, parameter :: length      = 4.0d0*atan(1.0d0)  ! pi
      real, parameter :: length      = 2.0d0*4.0d0*atan(1.0d0)/delta ! 2*pi*r
      ! mesh parameter
      logical, parameter :: if_sym   = .false.
      ! debug 2d geometry generation
      logical, parameter :: if_debug = .false.
      if (istep.eq.0) then
         ! Setup logger
         call logger_setup(nio=0, log_level=information_level, log_stdout=.false., log_timestamp=.true.)
         ! Initialize type, set geometry and compute forcing distribution
         call helix_pipe(delta, diameter, pitch_s, length, if_sym, if_debug)
      endif
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      end
c-----------------------------------------------------------------------
