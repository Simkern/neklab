c-----------------------------------------------------------------------
      subroutine userchk
      use stdlib_logger, only: debug_level, information_level
      use LightKrylov_Constants
      use LightKrylov_Timing, only: timer => global_lightkrylov_timer
      use LightKrylov_Logger
      use neklab
      use neklab_helix
      use neklab_nek_setup
      implicit none     
      include "SIZE"
      include "TOTAL"
      
      ! System for which we seek a fixed point
      type(nek_system_torus), allocatable :: sys
      ! State vectors
      type(nek_dvector) :: bf, ref
      ! Tolerance for the Newton solver
      real(dp) :: tol, tol_mf
      ! flow parameters
      real, parameter :: dp0ds = 7.9486896e-2
      real(dp), dimension(1) :: dpds
      real(dp), dimension(1), parameter :: mflow_target = [ 1.0_dp ]
      integer :: tol_mode, max_nwt_iter
      
      if (istep.eq.0) then
	      ! Set flow parameters
            dpds = [ dp0ds ]
            call pipe%init_flow(dpds)
                     
            call load_fld('rsttorus0.f00001')
            call nek2vec(bf, vx, vy, vz, pr, t)
   
            ! parameters
            tol          = 1e-6_dp
            tol_mf       = 1e-6_dp
            tol_mode     = 2
            max_nwt_iter = 10
            
            ! define system
            sys = nek_system_torus()
            sys%jacobian = nek_jacobian_torus()
            sys%jacobian%X = bf
            
            ! run nonlinear check
            !
            call compute_nonlinear_period_torus(ref, bf, save_2d = .false., variable_dt = .true., if_fft = .true., if_res = .true.)
            
            ! Run Newton
            !
            call newton_fixed_point_iteration(sys, bf, tol, tol_mode)
            
            ! Run mflow Newton
            !
            call mflow_newton(sys, bf, mflow_target, tol, tol_mf, tol_mode, max_nwt_iter)
            
            ! run nonlinear check
            !
            call compute_nonlinear_period_torus(ref, bf, save_2d = .true., variable_dt = .true., if_fft = .true., if_res = .true.)
            
            ! finalize timers
            !
            call timer%finalize(); call sys%jacobian%finalize_timer(); call timer%finalize()

            call nek_end()
      end if

      return

      end
